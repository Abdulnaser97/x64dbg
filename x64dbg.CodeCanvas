					"simulationKey": "How plugins work",
					"simStepId": "46b6fff6-8154-4c0d-a132-04842be6d16d"
				}
			]
		},
		"b80cbf2b-e770-4c0e-aaf2-927714801ca3": {
			"path": "b80cbf2b-e770-4c0e-aaf2-927714801ca3",
			"fileName": "b80cbf2b-e770-4c0e-aaf2-927714801ca3",
			"cellName": "Plugin Registers Callbacks and Commands - basics.md:L22",
			"cellId": "b80cbf2b-e770-4c0e-aaf2-927714801ca3",
			"visible": true,
			"parentCellId": "83b91164-daca-4010-9962-5df0e0468d77"
		},
		"docs/developers/plugins/basics.md-simstep-62f14771-ace9-426d-a464-d9051550f1de": {
			"path": "docs/developers/plugins/basics.md-simstep-62f14771-ace9-426d-a464-d9051550f1de",
			"fileName": "basics.md",
			"wiki": "Inside its 'pluginit' function, the plugin calls SDK functions to integrate with the debugger. It typically registers callbacks for events it's interested in (like 'CB_CREATEPROCESS') and registers custom commands.",
			"cellName": "Plugin Registers Callbacks and Commands - basics.md:L22",
			"cellId": "b80cbf2b-e770-4c0e-aaf2-927714801ca3",
			"visible": true,
			"startLine": 22,
			"endLine": 22,
			"parentCellId": "83b91164-daca-4010-9962-5df0e0468d77",
			"parentPath": "docs/developers/plugins/basics.md",
			"simSteps": [
				{
					"simulationKey": "How plugins work",
					"simStepId": "62f14771-ace9-426d-a464-d9051550f1de"
				}
			]
		},
		"99a1411b-b77e-4865-9156-3660e532cc1f": {
			"path": "99a1411b-b77e-4865-9156-3660e532cc1f",
			"fileName": "99a1411b-b77e-4865-9156-3660e532cc1f",
			"cellName": "Store Callback in Registry - plugin_loader.cpp:L645-654",
			"cellId": "99a1411b-b77e-4865-9156-3660e532cc1f",
			"visible": true,
			"parentCellId": "232037a5-31e9-427c-abd5-539ebafaad95"
		},
