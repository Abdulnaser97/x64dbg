		},
		"be00a6ef-cf1d-4356-a55f-888c881f1329": {
			"path": "be00a6ef-cf1d-4356-a55f-888c881f1329",
			"fileName": "be00a6ef-cf1d-4356-a55f-888c881f1329",
			"cellName": "Software Breakpoint: TitanEngine's `SetBPX` Patches Memory - TitanEngine.txt:L2470-2486",
			"cellId": "be00a6ef-cf1d-4356-a55f-888c881f1329",
			"visible": true,
			"parentCellId": "ee9eb810-2328-432a-a440-253dd1f0a1c8"
