				{
					"simulationKey": "How symbol and source-level debugging works",
					"simStepId": "fae0bf1a-b24a-4b18-98f0-862dc1cc1803"
				}
			]
		},
		"f2deb9df-dc31-40dd-80ea-14512e43aca8": {
			"path": "f2deb9df-dc31-40dd-80ea-14512e43aca8",
			"fileName": "f2deb9df-dc31-40dd-80ea-14512e43aca8",
			"cellName": "Cache and Index Symbols - symbolsourcedia.cpp:L173-237",
