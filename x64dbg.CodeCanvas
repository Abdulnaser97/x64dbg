						]
					},
					"inputDataExample": "{\"cbType\": \"CB_CREATEPROCESS\", \"callbackInfo\": {\"CreateProcessInfo\": {\"lpBaseOfImage\": \"0x400000\"}, \"modInfo\": {...}, \"DebugFileName\": \"C:\\\\path\\\\to\\\\debuggee.exe\"}}",
					"outputDataExample": "{\"cbType\": \"CB_CREATEPROCESS\", \"callbackInfo\": {\"CreateProcessInfo\": {\"lpBaseOfImage\": \"0x400000\"}, \"modInfo\": {...}, \"DebugFileName\": \"C:\\\\path\\\\to\\\\debuggee.exe\"}}"
				},
				{
					"simStepId": "38eca4be-07d8-499c-95c3-8b7875579a43",
					"diagramNodeId": "a5c8ff15-898a-410e-b123-6603f5fa3ac8",
					"simStepLabel": "Plugin Executes Custom Logic",
					"simStepDescription": "The plugin's specific code for the 'CB_CREATEPROCESS' event runs. For example, it might log the process name, set initial breakpoints, or perform other analysis tasks. Once the function returns, control goes back to the debugger.",
					"isEdge": 0,
					"sourceCodeMapping": {
