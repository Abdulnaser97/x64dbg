		"src/gui/Src/Gui/DisassemblerGraphView.cpp-simstep-65f43ea7-a68a-4e89-8ad7-c74225c9b979": {
			"path": "src/gui/Src/Gui/DisassemblerGraphView.cpp-simstep-65f43ea7-a68a-4e89-8ad7-c74225c9b979",
			"fileName": "DisassemblerGraphView.cpp",
			"wiki": "If any cross-references were found, the `xrefSlot` creates and displays an `XrefBrowseDialog`, populating it with the list of addresses that refer to the target. The user can then double-click an entry in this dialog to navigate to that location.",
			"cellName": "Final Step: Display X-Ref Dialog - DisassemblerGraphView.cpp:L2626-2631",
			"cellId": "d10aca7d-cd07-44f4-be6e-3649089158fd",
