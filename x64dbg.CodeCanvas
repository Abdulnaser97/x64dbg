		"How plugins work": {
			"name": "How plugins work",
			"simSteps": [
				{
					"simStepId": "90156746-6c44-47f7-ae63-34f169dc5f20",
					"diagramNodeId": "d2db73d4-b424-40bf-9582-f291fd497693",
					"simStepLabel": "Plugin Load Command Issued",
					"simStepDescription": "The user initiates the loading of a plugin by typing the 'plugload' command into the x64dbg command bar. This command is registered by the debugger core at startup.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/x64dbg.cpp",
						"startLine": "424",
						"endLine": "424",
						"relevantVariables": [
							"cbInstrPluginLoad",
							"dbgcmdnew"
						]
					},
					"inputDataExample": "{\"commandText\": \"plugload mytracer\"}",
					"outputDataExample": "{\"commandName\": \"plugload\", \"arguments\": [\"mytracer\"]}"
				},
				{
					"simStepId": "8c8e3dfd-5a9c-4305-9cdc-267f198382bb",
					"diagramNodeId": "2530a3e1-ba26-4b85-a4f1-50b840ad203e",
					"simStepLabel": "Command Dispatch",
					"simStepDescription": "The debugger's command processor dispatches the command and its arguments to the registered handler function, 'cbInstrPluginLoad'.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-plugins.cpp",
						"startLine": "9",
						"endLine": "12",
						"relevantVariables": [
							"cbInstrPluginLoad",
							"pluginload"
						]
					},
					"inputDataExample": "{\"commandName\": \"plugload\", \"arguments\": [\"mytracer\"]}",
					"outputDataExample": "{\"commandName\": \"plugload\", \"arguments\": [\"mytracer\"]}"
				},
				{
					"simStepId": "46b6fff6-8154-4c0d-a132-04842be6d16d",
					"diagramNodeId": "ca58fa66-7793-4311-a779-9b8709768fa8",
					"simStepLabel": "Load Plugin DLL",
					"simStepDescription": "The 'pluginload' function is the core of the plugin loading mechanism. It resolves the full path to the plugin's DLL file and loads it into the debugger's process space using the Windows API 'LoadLibraryW'.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/plugin_loader.cpp",
						"startLine": "208",
						"endLine": "214",
						"relevantVariables": [
							"pluginPath",
							"gLoadingPlugin.hPlugin",
							"LoadLibraryW"
						]
					},
					"inputDataExample": "{\"pluginName\": \"mytracer\", \"loadall\": false}",
					"outputDataExample": "{\"hPlugin\": \"0x00007FFAB46A0000\", \"pluginName\": \"mytracer\"}"
				},
				{
					"simStepId": "8505d38e-f498-47f7-bb4c-465bf221d167",
					"diagramNodeId": "cb818cb1-209c-4a43-baae-0f23415423d8",
					"simStepLabel": "Call Plugin 'pluginit'",
					"simStepDescription": "After successfully loading the DLL, the debugger retrieves the address of the exported 'pluginit' function and calls it. A 'PLUG_INITSTRUCT' is passed, which contains a handle for the plugin to use in subsequent API calls.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/plugin_loader.cpp",
						"startLine": "232",
						"endLine": "239",
						"relevantVariables": [
							"gLoadingPlugin.pluginit",
							"gLoadingPlugin.initStruct"
						]
					},
					"inputDataExample": "{\"PLUG_INITSTRUCT\": {\"pluginHandle\": 1, \"sdkVersion\": null, \"pluginVersion\": null, \"pluginName\": \"\"}}",
					"outputDataExample": "{\"PLUG_INITSTRUCT\": {\"pluginHandle\": 1, \"sdkVersion\": 1, \"pluginVersion\": 1, \"pluginName\": \"MyTracer\"}}"
				},
				{
					"simStepId": "62f14771-ace9-426d-a464-d9051550f1de",
					"diagramNodeId": "b80cbf2b-e770-4c0e-aaf2-927714801ca3",
					"simStepLabel": "Plugin Registers Callbacks and Commands",
					"simStepDescription": "Inside its 'pluginit' function, the plugin calls SDK functions to integrate with the debugger. It typically registers callbacks for events it's interested in (like 'CB_CREATEPROCESS') and registers custom commands.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "docs/developers/plugins/basics.md",
						"startLine": "22",
						"endLine": "22",
						"relevantVariables": [
							"pluginit",
							"PLUG_INITSTRUCT"
						]
					},
					"inputDataExample": "{\"initStruct\": {\"pluginHandle\": 1}}",
					"outputDataExample": "{\"registrationResult\": true}"
				},
				{
					"simStepId": "126c4da5-60d4-409a-80b2-78975ef88b3d",
					"diagramNodeId": "4ad16642-1c06-489e-b34f-707568f7efa0",
					"simStepLabel": "Plugin->SDK: Register Callback",
					"simStepDescription": "The plugin calls '_plugin_registercallback' to subscribe to the 'CB_CREATEPROCESS' event, providing a pointer to its own handler function.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/_plugins.cpp",
						"startLine": "15",
						"endLine": "18",
						"relevantVariables": [
							"_plugin_registercallback",
							"pluginregistercallback"
						]
					},
					"inputDataExample": "{\"pluginHandle\": 1, \"cbType\": \"CB_CREATEPROCESS\", \"cbPlugin\": \"0x...\"}",
					"outputDataExample": "{\"pluginHandle\": 1, \"cbType\": \"CB_CREATEPROCESS\", \"cbPlugin\": \"0x...\"}"
				},
				{
					"simStepId": "697db2c1-716e-4091-a5fc-29f1f9f95d74",
					"diagramNodeId": "99a1411b-b77e-4865-9156-3660e532cc1f",
					"simStepLabel": "Store Callback in Registry",
					"simStepDescription": "The 'pluginregistercallback' function stores the plugin's handle and function pointer in a global list, 'gPluginCallbackList', indexed by the callback type.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/plugin_loader.cpp",
						"startLine": "645",
						"endLine": "654",
						"relevantVariables": [
							"pluginregistercallback",
							"gPluginCallbackList",
							"cbStruct"
						]
					},
					"inputDataExample": "{\"pluginHandle\": 1, \"cbType\": \"CB_CREATEPROCESS\", \"cbPlugin\": \"0x...\"}",
					"outputDataExample": "null"
				},
				{
					"simStepId": "3316e9f1-1777-437d-94b9-3b7ab1edb3ef",
					"diagramNodeId": "a645c7e7-f024-4f18-b60f-31e36bf2ca95",
					"simStepLabel": "Plugin->SDK: Register Command",
					"simStepDescription": "The plugin calls '_plugin_registercommand' to add a new command, 'mycommand', to the debugger.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/_plugins.cpp",
						"startLine": "25",
						"endLine": "28",
						"relevantVariables": [
							"_plugin_registercommand",
							"plugincmdregister"
						]
					},
					"inputDataExample": "{\"pluginHandle\": 1, \"command\": \"mycommand\", \"cbCommand\": \"0x...\", \"debugonly\": true}",
					"outputDataExample": "{\"pluginHandle\": 1, \"command\": \"mycommand\", \"cbCommand\": \"0x...\", \"debugonly\": true}"
				},
				{
					"simStepId": "a6347319-f1f6-4b3e-b191-b849b91da38d",
					"diagramNodeId": "a05dfd40-f9a2-452f-b0a4-eee8ad067be3",
					"simStepLabel": "Store Command in Registry",
					"simStepDescription": "The 'plugincmdregister' function adds the command to the debugger's central command system via 'dbgcmdnew' and tracks it in the 'gPluginCommandList'.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/plugin_loader.cpp",
						"startLine": "732",
						"endLine": "752",
						"relevantVariables": [
							"plugincmdregister",
							"dbgcmdnew",
							"gPluginCommandList"
						]
					},
					"inputDataExample": "{\"pluginHandle\": 1, \"command\": \"mycommand\", \"cbCommand\": \"0x...\", \"debugonly\": true}",
					"outputDataExample": "{\"result\": true}"
				},
				{
					"simStepId": "f50b7c0c-b3da-46ae-9f14-829f1ad908a6",
					"diagramNodeId": "65f9b4b1-c8cb-4888-893c-8ddcd0eae5bc",
					"simStepLabel": "Call Plugin 'plugsetup'",
					"simStepDescription": "After 'pluginit' succeeds, 'pluginload' calls the optional 'plugsetup' export from the plugin. This function is intended for GUI-related setup, like adding menu items. A 'PLUG_SETUPSTRUCT' containing handles to various menus is passed.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/plugin_loader.cpp",
						"startLine": "336",
						"endLine": "348",
						"relevantVariables": [
							"gLoadingPlugin.plugsetup",
							"setupStruct"
						]
					},
					"inputDataExample": "{\"PLUG_SETUPSTRUCT\": {\"hwndDlg\": \"0x12345\", \"hMenu\": 1, \"hMenuDisasm\": 2, \"hMenuDump\": 3, \"hMenuStack\": 4, \"hMenuGraph\": 5, \"hMenuMemmap\": 6, \"hMenuSymmod\": 7}}",
					"outputDataExample": "{\"PLUG_SETUPSTRUCT\": {\"hwndDlg\": \"0x12345\", \"hMenu\": 1, \"hMenuDisasm\": 2, \"hMenuDump\": 3, \"hMenuStack\": 4, \"hMenuGraph\": 5, \"hMenuMemmap\": 6, \"hMenuSymmod\": 7}}"
				},
				{
					"simStepId": "dc04dcbb-b183-4b02-98da-b45606d0212e",
					"diagramNodeId": "fae8d52f-6db0-4229-b827-1a9323673ecf",
					"simStepLabel": "Plugin Setup GUI",
					"simStepDescription": "The plugin's 'plugsetup' function executes. It uses the provided menu handles to add its own menus and menu entries via SDK functions like '_plugin_menuadd' and '_plugin_menuaddentry'. The plugin is now fully loaded and visible in the GUI.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "docs/developers/plugins/basics.md",
						"startLine": "24",
						"endLine": "24",
						"relevantVariables": [
							"plugsetup",
							"PLUG_SETUPSTRUCT"
						]
					},
					"inputDataExample": "{\"setupStruct\": {\"hMenu\": 1, \"hMenuDisasm\": 2}}",
					"outputDataExample": "null"
				},
				{
					"simStepId": "07aa3110-c08d-4570-bde1-4670867e901b",
					"diagramNodeId": "de5f589a-9195-46a6-825e-5cb4450f8433",
					"simStepLabel": "Debugger Event Triggered",
					"simStepDescription": "Later, the debugger attaches to a new process. This triggers a 'CREATE_PROCESS_DEBUG_EVENT', causing the debugger's internal event handler to execute.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "1505",
						"endLine": "1505",
						"relevantVariables": [
