		"0f8c9945-3ad2-4bd9-9dfa-448966a3bc58": {
			"path": "0f8c9945-3ad2-4bd9-9dfa-448966a3bc58",
			"fileName": "0f8c9945-3ad2-4bd9-9dfa-448966a3bc58",
			"cellName": "Flow: Init Debug - User Issues 'init' Command - x64dbg.cpp:L144",
			"cellId": "0f8c9945-3ad2-4bd9-9dfa-448966a3bc58",
			"visible": true,
			"parentCellId": "4baa9d03-cfb0-47b5-a48a-2e404daaa246"
		},
		"src/dbg/x64dbg.cpp-simstep-f98baeed-d375-4f25-aad2-dbd6f4913d36": {
			"path": "src/dbg/x64dbg.cpp-simstep-f98baeed-d375-4f25-aad2-dbd6f4913d36",
			"fileName": "x64dbg.cpp",
			"wiki": "The debug session is initiated when the user executes the 'init' command, providing the path to an executable. This command is registered by the debugger core to a callback function that handles process creation.",
			"cellName": "Flow: Init Debug - User Issues 'init' Command - x64dbg.cpp:L144",
			"cellId": "0f8c9945-3ad2-4bd9-9dfa-448966a3bc58",
			"visible": true,
			"startLine": 144,
			"endLine": 144,
			"parentCellId": "4baa9d03-cfb0-47b5-a48a-2e404daaa246",
			"parentPath": "src/dbg/x64dbg.cpp",
			"simSteps": [
				{
					"simulationKey": "How debug execution control works",
					"simStepId": "f98baeed-d375-4f25-aad2-dbd6f4913d36"
				}
			]
		},
		"4a02a440-0660-413f-854b-81c571c108ec": {
			"path": "4a02a440-0660-413f-854b-81c571c108ec",
			"fileName": "4a02a440-0660-413f-854b-81c571c108ec",
			"cellName": "Flow: Init Debug - Prepare and Create Debug Thread - cmd-debug-control.cpp:L66-178",
			"cellId": "4a02a440-0660-413f-854b-81c571c108ec",
			"visible": true,
			"parentCellId": "110ba731-9074-4a40-a86e-74cc73f27d55"
		},
		"src/dbg/commands/cmd-debug-control.cpp-simstep-3f11e844-015f-4c47-be09-bdc31026f52a": {
			"path": "src/dbg/commands/cmd-debug-control.cpp-simstep-3f11e844-015f-4c47-be09-bdc31026f52a",
			"fileName": "cmd-debug-control.cpp",
			"wiki": "The `cbDebugInit` function resolves the file path, determines the architecture, and prepares an `INIT_STRUCT` with the necessary information. It then calls `dbgcreatedebugthread` to spawn a new thread that will manage the debuggee.",
			"cellName": "Flow: Init Debug - Prepare and Create Debug Thread - cmd-debug-control.cpp:L66-178",
			"cellId": "4a02a440-0660-413f-854b-81c571c108ec",
			"visible": true,
			"startLine": 66,
			"endLine": 178,
			"parentCellId": "110ba731-9074-4a40-a86e-74cc73f27d55",
			"parentPath": "src/dbg/commands/cmd-debug-control.cpp",
			"simSteps": [
				{
					"simulationKey": "How debug execution control works",
					"simStepId": "3f11e844-015f-4c47-be09-bdc31026f52a"
				}
			]
		},
		"2403d3f4-49d5-4786-a20c-589b0ac46e9f": {
			"path": "2403d3f4-49d5-4786-a20c-589b0ac46e9f",
			"fileName": "2403d3f4-49d5-4786-a20c-589b0ac46e9f",
			"cellName": "Flow: Init Debug - Create Process and Start Debug Loop - debugger.cpp:L2859-2976",
			"cellId": "2403d3f4-49d5-4786-a20c-589b0ac46e9f",
			"visible": true,
			"parentCellId": "4cedaf68-408e-481a-8895-afcd92ae8b82"
		},
		"src/dbg/debugger.cpp-simstep-5e7d07a6-2a89-4a76-a69f-a94c35442ef2": {
			"path": "src/dbg/debugger.cpp-simstep-5e7d07a6-2a89-4a76-a69f-a94c35442ef2",
			"fileName": "debugger.cpp",
			"wiki": "The `debugLoopFunction` calls `InitDebugW` (from TitanEngine) to create the target process in a suspended state. It then sets up handlers for various debug events (process creation, thread creation, exceptions, etc.) and finally enters the main `DebugLoop`, which waits for OS debug events.",
			"cellName": "Flow: Init Debug - Create Process and Start Debug Loop - debugger.cpp:L2859-2976",
			"cellId": "2403d3f4-49d5-4786-a20c-589b0ac46e9f",
			"visible": true,
			"startLine": 2859,
			"endLine": 2976,
			"parentCellId": "4cedaf68-408e-481a-8895-afcd92ae8b82",
			"parentPath": "src/dbg/debugger.cpp",
			"simSteps": [
				{
					"simulationKey": "How debug execution control works",
					"simStepId": "5e7d07a6-2a89-4a76-a69f-a94c35442ef2"
				}
			]
		},
		"fc9d372f-58a8-437c-bd78-612c3d1470cd": {
			"path": "fc9d372f-58a8-437c-bd78-612c3d1470cd",
			"fileName": "fc9d372f-58a8-437c-bd78-612c3d1470cd",
			"cellName": "Flow: Init Debug - Handle System Breakpoint and Pause - debugger.cpp:L1793-1841",
