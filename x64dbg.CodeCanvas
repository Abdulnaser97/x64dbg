		"docs/developers/plugins/basics.md-simstep-dc04dcbb-b183-4b02-98da-b45606d0212e": {
			"path": "docs/developers/plugins/basics.md-simstep-dc04dcbb-b183-4b02-98da-b45606d0212e",
			"fileName": "basics.md",
			"wiki": "The plugin's 'plugsetup' function executes. It uses the provided menu handles to add its own menus and menu entries via SDK functions like '_plugin_menuadd' and '_plugin_menuaddentry'. The plugin is now fully loaded and visible in the GUI.",
			"cellName": "Plugin Setup GUI - basics.md:L24",
			"cellId": "fae8d52f-6db0-4229-b827-1a9323673ecf",
			"visible": true,
			"startLine": 24,
			"endLine": 24,
			"parentCellId": "83b91164-daca-4010-9962-5df0e0468d77",
			"parentPath": "docs/developers/plugins/basics.md",
			"simSteps": [
				{
					"simulationKey": "How plugins work",
					"simStepId": "dc04dcbb-b183-4b02-98da-b45606d0212e"
				}
			]
		},
		"d7ace5b1-8e14-4935-b227-3199ab50da58": {
