			"path": "src/gui/Src/Bridge/Bridge.cpp-simstep-d95fa17d-54cc-48f7-8fb0-d54ba9c91578",
			"fileName": "Bridge.cpp",
			"wiki": "The bridge processes the `GUI_UPDATE_DUMP_VIEW` and `GUI_UPDATE_CALLSTACK` messages, emitting the corresponding `updateDump()` and `updateCallStack()` signals.",
			"cellName": "Bridge Emits Update Signals for Dumps and Stack - Bridge.cpp:L129-155",
			"cellId": "5f89b73b-b1c8-4126-8b4c-41012e6bf958",
