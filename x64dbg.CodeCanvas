		"src/dbg/_exports.cpp-simstep-705d4f35-af17-4753-b8db-6889be289dc9": {
			"path": "src/dbg/_exports.cpp-simstep-705d4f35-af17-4753-b8db-6889be289dc9",
			"fileName": "_exports.cpp",
			"wiki": "The `DbgXrefGet` function (abstracted, as `xrefs.cpp` is not provided) queries the debugger's internal cross-reference database. This database, built during analysis passes, stores all known locations that refer to any given address, including calls, jumps, and data references.",
			"cellName": "Backend: X-Ref Analysis - _exports.cpp:L102-889",
			"cellId": "80dfedcd-fa3a-4bc1-85b6-ad7c932e3f32",
			"visible": true,
