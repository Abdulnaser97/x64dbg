				{
					"simulationKey": "How inspecting program state works",
					"simStepId": "d95fa17d-54cc-48f7-8fb0-d54ba9c91578"
				}
			]
		},
		"d4e98c5b-dcde-4c5c-9ea2-631033010b03": {
			"path": "d4e98c5b-dcde-4c5c-9ea2-631033010b03",
			"fileName": "d4e98c5b-dcde-4c5c-9ea2-631033010b03",
