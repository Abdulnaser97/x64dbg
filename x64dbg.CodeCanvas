		"src/dbg/x64dbg.cpp-simstep-90156746-6c44-47f7-ae63-34f169dc5f20": {
			"path": "src/dbg/x64dbg.cpp-simstep-90156746-6c44-47f7-ae63-34f169dc5f20",
			"fileName": "x64dbg.cpp",
			"wiki": "The user initiates the loading of a plugin by typing the 'plugload' command into the x64dbg command bar. This command is registered by the debugger core at startup.",
