						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{}"
				},
				{
					"simStepId": "a787d9ce-0fb6-4ad1-a617-1559466ee9b2",
					"diagramNodeId": "39cdaf10-8d4e-4bc0-9207-5267dd8c9224",
					"simStepLabel": "Debugger Core: Update Memory Map",
					"simStepDescription": "The debugger core's `MemUpdateMap` function is invoked. It queries all memory pages of the debuggee process using `VirtualQueryEx`, processes PE section information, and identifies special regions like stacks, heaps, PEB, and TEBs.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/memory.cpp",
						"startLine": "494",
						"endLine": "527",
						"relevantVariables": [
							"MemUpdateMap",
							"QueryMemPages",
							"ProcessFileSections",
							"ProcessSystemPages",
							"memoryPages"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{\"memoryMap\": {\"count\": 150, \"page\": [{\"mbi\": {\"BaseAddress\": \"0x400000\", \"RegionSize\": \"0x1000\", \"Protect\": \"PAGE_EXECUTE_READ\"}, \"info\": \".text\"}]}}"
				},
				{
					"simStepId": "c7998253-fbc7-4d28-9bbb-bf332019013e",
					"diagramNodeId": "9c4eed9f-41e7-4adc-96bd-85e3f1e7340c",
					"simStepLabel": "Transmit Memory Map Data to GUI",
					"simStepDescription": "The populated `MEMMAP` structure containing information about all memory regions is returned to the GUI thread.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/MemoryMapView.cpp",
						"startLine": "478",
						"endLine": "478",
						"relevantVariables": [
							"memoryMap"
						]
					},
					"inputDataExample": "{\"memoryMap\": {\"count\": 150, \"page\": [{\"mbi\": {\"BaseAddress\": \"0x400000\", \"RegionSize\": \"0x1000\", \"Protect\": \"PAGE_EXECUTE_READ\"}, \"info\": \".text\"}]}}",
					"outputDataExample": "{\"memoryMap\": {\"count\": 150, \"page\": [{\"mbi\": {\"BaseAddress\": \"0x400000\", \"RegionSize\": \"0x1000\", \"Protect\": \"PAGE_EXECUTE_READ\"}, \"info\": \".text\"}]}}"
				},
				{
					"simStepId": "295fa825-f09a-45d5-98a7-0e403d7ff52f",
					"diagramNodeId": "2ae4fb04-1731-48e3-b64b-5b45bfd1aa43",
					"simStepLabel": "GUI: Populate Memory Map View",
					"simStepDescription": "The `refreshMapSlot` function iterates through the received memory map data, populating the table view with details for each memory region, such as address, size, protection, and type. It then calls `reloadData` to repaint the view.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/MemoryMapView.cpp",
						"startLine": "475",
						"endLine": "578",
						"relevantVariables": [
							"refreshMapSlot",
							"memoryMap",
							"setCellContent",
							"reloadData"
						]
					},
					"inputDataExample": "{\"memoryMap\": {\"count\": 150, \"page\": [{\"mbi\": {\"BaseAddress\": \"0x400000\", \"RegionSize\": \"0x1000\", \"Protect\": \"PAGE_EXECUTE_READ\"}, \"info\": \".text\"}]}}",
					"outputDataExample": "{}"
				},
				{
					"simStepId": "536d8d48-a0c0-4c71-bd8f-3a0517146add",
					"diagramNodeId": "79489143-0167-4dfb-a39c-477c5f917053",
					"simStepLabel": "User Action: Assemble Instruction",
					"simStepDescription": "The user right-clicks an instruction in the CPU Disassembly view and selects 'Assemble' from the context menu, which triggers the `assembleSlot`.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/CPUDisassembly.cpp",
						"startLine": "529",
						"endLine": "529",
						"relevantVariables": [
							"assembleSlot"
						]
					},
					"inputDataExample": "{\"userAction\": \"Right-click -> Assemble\"}",
					"outputDataExample": "{\"userAction\": \"Right-click -> Assemble\"}"
				},
				{
					"simStepId": "85531d93-a019-42d0-a6ab-88062eaffffd",
					"diagramNodeId": "65ba6020-8419-4fae-8329-6954dcb74763",
					"simStepLabel": "GUI: Open Assemble Dialog",
					"simStepDescription": "The `assembleSlot` in `CPUDisassembly.cpp` is executed. It opens the `AssembleDialog`, allowing the user to input a new assembly instruction. Upon confirmation, it calls `DbgFunctions()->AssembleAtEx` to process the new instruction.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/CPUDisassembly.cpp",
						"startLine": "892",
						"endLine": "973",
						"relevantVariables": [
							"assembleSlot",
							"AssembleDialog",
							"DbgFunctions()->AssembleAtEx"
						]
					},
					"inputDataExample": "{\"address\": \"0x00401050\", \"instruction\": \"mov eax, eax\"}",
					"outputDataExample": "{\"address\": \"0x00401050\", \"newInstruction\": \"nop\", \"fillWithNops\": true}"
				},
				{
					"simStepId": "f58f5f8b-f60f-48bb-8cb2-c07e52efd559",
					"diagramNodeId": "e85ba718-57ca-4c4e-81d2-d140cc3cad45",
					"simStepLabel": "Request Memory Patch",
					"simStepDescription": "After assembling the instruction into bytes, `assembleat` calls `MemPatch` to write the new bytes into the debuggee's memory.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/assemble.cpp",
						"startLine": "139",
						"endLine": "139",
						"relevantVariables": [
							"MemPatch",
							"addr",
							"dest()",
							"destSize"
						]
					},
					"inputDataExample": "{\"address\": \"0x00401050\", \"bytes\": [144], \"size\": 1}",
					"outputDataExample": "{\"address\": \"0x00401050\", \"bytes\": [144], \"size\": 1}"
				},
				{
					"simStepId": "8c27b85b-10db-43c2-b3b1-23300b83a06f",
					"diagramNodeId": "f1a10fa7-b91f-4cf6-a760-ba617fd51b9a",
					"simStepLabel": "Debugger Core: Patch Memory",
					"simStepDescription": "The `MemPatch` function in `memory.cpp` first reads the original bytes from the target address (`MemRead`), then writes the new bytes (`MemWrite`), and finally calls `PatchSet` to record the modification.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/memory.cpp",
						"startLine": "746",
						"endLine": "774",
						"relevantVariables": [
							"MemPatch",
							"MemRead",
							"MemWrite",
							"PatchSet",
							"oldData"
						]
					},
					"inputDataExample": "{\"BaseAddress\": \"0x00401050\", \"Buffer\": [144], \"Size\": 1}",
					"outputDataExample": "{\"BaseAddress\": \"0x00401050\", \"oldByte\": 85, \"newByte\": 144}"
				},
				{
					"simStepId": "65572f52-5499-4fda-9e5c-ec9b466c76b8",
					"diagramNodeId": "5f863798-9fee-4795-a6b3-ef99afcb820e",
					"simStepLabel": "Update Patch Information",
					"simStepDescription": "`MemPatch` calls `PatchSet` for each modified byte to log the change.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/memory.cpp",
						"startLine": "765",
						"endLine": "766",
						"relevantVariables": [
							"PatchSet"
						]
					},
					"inputDataExample": "{\"address\": \"0x00401050\", \"oldByte\": 85, \"newByte\": 144}",
					"outputDataExample": "{\"address\": \"0x00401050\", \"oldByte\": 85, \"newByte\": 144}"
				},
				{
					"simStepId": "6b41a7f9-c245-4e49-a1fd-df2c668a45f4",
					"diagramNodeId": "f010d7a4-2b77-473c-8337-301b497a4eb0",
					"simStepLabel": "Debugger Core: Track Patch",
					"simStepDescription": "The `PatchSet` function in `patches.cpp` adds or updates a `PATCHINFO` structure in a global map. This map keeps track of all memory modifications, storing the address, original byte, and new byte.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/patches.cpp",
						"startLine": "16",
						"endLine": "20",
						"relevantVariables": [
							"PatchSet",
							"patches",
							"newPatch"
						]
					},
					"inputDataExample": "{\"Address\": \"0x00401050\", \"OldByte\": 85, \"NewByte\": 144}",
					"outputDataExample": "{\"patchInfo\": {\"addr\": \"0x1050\", \"mod\": \"executable.exe\", \"oldbyte\": 85, \"newbyte\": 144}}"
				},
				{
					"simStepId": "ea7da752-666a-4eb9-b9ce-3f1190a5e856",
					"diagramNodeId": "39af0264-13ed-473c-ae35-1c9d8b2368f3",
					"simStepLabel": "Signal GUI to Update Patches View",
					"simStepDescription": "After a successful patch, the debugger core signals the GUI to update its views, specifically the Patches view, to reflect the new state.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/assemble.cpp",
						"startLine": "153",
						"endLine": "153",
						"relevantVariables": [
							"GuiUpdatePatches"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{}"
				},
				{
					"simStepId": "f983191d-7edd-4b1b-9887-bca0772ef83d",
					"diagramNodeId": "8ca60ead-5682-4729-a6f3-696ded7471e7",
					"simStepLabel": "GUI: Receive Patch Update Signal and Refresh Patches Dialog",
					"simStepDescription": "The `PatchDialog` receives the `updatePatches` signal. It calls `DbgFunctions()->PatchEnum` to get the latest list of all patches from the debugger core and repopulates its list view.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/PatchDialog.cpp",
						"startLine": "181",
						"endLine": "618",
						"relevantVariables": [
							"updatePatches",
							"DbgFunctions()->PatchEnum",
							"mPatches"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "[{\"addr\": \"0x00401050\", \"mod\": \"executable.exe\", \"oldbyte\": 85, \"newbyte\": 144}]"
				},
				{
					"simStepId": "2586fa83-8f0c-480b-b97b-ad8864def144",
					"diagramNodeId": "f08f5d5f-e1bc-4885-bc63-e09cb585abc8",
					"simStepLabel": "User Action: Toggle a Patch",
					"simStepDescription": "The user unchecks a patch in the `PatchDialog`. This triggers the `on_listPatches_itemChanged` slot.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/PatchDialog.cpp",
						"startLine": "276",
						"endLine": "276",
						"relevantVariables": [
							"on_listPatches_itemChanged"
						]
					},
					"inputDataExample": "{\"patchIndex\": 0, \"checked\": false}",
					"outputDataExample": "{\"patchIndex\": 0, \"checked\": false}"
				},
				{
					"simStepId": "32b478f9-c688-47eb-b58a-4c27f5e2303d",
					"diagramNodeId": "769da604-425b-48bd-8779-8e96f7e869a8",
					"simStepLabel": "GUI: Restore Original Byte",
					"simStepDescription": "The `on_listPatches_itemChanged` slot determines that the patch was unchecked and calls `DbgMemWrite` to write the original byte back to the target memory address, effectively disabling the patch.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/PatchDialog.cpp",
						"startLine": "290",
						"endLine": "292",
						"relevantVariables": [
							"DbgMemWrite",
							"writebyte",
							"patch.patch.oldbyte"
						]
					},
					"inputDataExample": "{\"address\": \"0x00401050\", \"byteToWrite\": 85}",
					"outputDataExample": "{}"
				},
				{
					"simStepId": "6b82fb64-bb63-485c-a78f-d6809fd28f58",
					"diagramNodeId": "7952a82e-aa4e-44ae-b8ac-fba87740f960",
					"simStepLabel": "User Action: Save Memory Region to File",
					"simStepDescription": "The user selects a memory region in the Memory Map view, right-clicks, and chooses 'Dump Memory to File'. This triggers the `dumpMemorySlot`.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/MemoryMapView.cpp",
						"startLine": "174",
						"endLine": "174",
						"relevantVariables": [
							"dumpMemorySlot"
						]
					},
					"inputDataExample": "{\"userAction\": \"Right-click -> Dump Memory to File\"}",
					"outputDataExample": "{\"userAction\": \"Right-click -> Dump Memory to File\"}"
				},
				{
					"simStepId": "f2f06ecf-fbe8-48ac-87a8-8be166310f3f",
					"diagramNodeId": "8f81fd69-f4a0-4abb-b12b-e75b1bd0da92",
					"simStepLabel": "GUI: Execute 'savedata' Command",
					"simStepDescription": "The `dumpMemorySlot` opens a file dialog. After the user chooses a file name, it executes the 'savedata' command via `DbgCmdExec`, passing the file name, start address, and size of the selected region.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/MemoryMapView.cpp",
						"startLine": "725",
						"endLine": "756",
						"relevantVariables": [
							"dumpMemorySlot",
							"QFileDialog::getSaveFileName",
							"DbgCmdExec",
							"savedata"
						]
					},
					"inputDataExample": "{\"fileName\": \"C:\\dump.bin\", \"start\": \"0x7FF6B2A20000\", \"size\": \"0x1000\"}",
					"outputDataExample": "{\"command\": \"savedata \\\"C:\\\\dump.bin\\\",0x7FF6B2A20000,0x1000\"}"
				},
				{
					"simStepId": "c137718f-6f91-4eb4-91d4-f2b1b1490edf",
					"diagramNodeId": "039feb33-dc2a-49ef-8a7d-ed11b0796a4e",
					"simStepLabel": "Process 'savedata' Command",
					"simStepDescription": "The command string is passed to the debugger's command processor.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/x64dbg.cpp",
						"startLine": "292",
						"endLine": "292",
						"relevantVariables": [
							"cbInstrSavedata"
						]
					},
					"inputDataExample": "{\"command\": \"savedata \\\"C:\\\\dump.bin\\\",0x7FF6B2A20000,0x1000\"}",
					"outputDataExample": "{\"command\": \"savedata \\\"C:\\\\dump.bin\\\",0x7FF6B2A20000,0x1000\"}"
				},
				{
					"simStepId": "047898bb-3560-488c-9295-76e0782ee18b",
					"diagramNodeId": "07fe13b1-9e0b-4d02-b7b7-c74d9ffda4a2",
					"simStepLabel": "Debugger Core: Read Memory and Write to File",
					"simStepDescription": "The `cbInstrSavedata` command handler is executed. It parses the arguments, reads the specified memory region from the debuggee using `MemReadDumb`, and writes the resulting data to the specified file.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-memory-operations.cpp",
						"startLine": "176",
						"endLine": "180",
						"relevantVariables": [
							"cbInstrSavedata",
							"MemReadDumb",
							"FileHelper::WriteAllData"
						]
					},
					"inputDataExample": "{\"command\": \"savedata \\\"C:\\\\dump.bin\\\",0x7FF6B2A20000,0x1000\"}",
					"outputDataExample": "{\"bytesWritten\": 4096, \"filePath\": \"C:\\dump.bin\"}"
				}
			],
			"description": "<ul><li>- The Memory Map view displays a list of all memory regions allocated by the debuggee, showing their protection status, type, and associated module</li><li>- Any memory region can be viewed in the Dump view, which supports various data type interpretations (hex, ASCII, integers, floats)</li><li>- Users can directly modify memory in the Dump, Disassembly (via assemble), or Stack views</li><li>These modifications are called patches</li><li>- The Patches view tracks all active modifications, allowing users to enable, disable, or save them to a file</li></ul>",
			"simulationNodesAndEdges": {
