					"simulationKey": "How symbol and source-level debugging works",
					"simStepId": "657ccbcc-6a7c-42ad-a219-fce898eee9c5"
				}
			]
		},
		"a227f5bc-b31a-4569-974f-fbdc65eb2429": {
			"path": "a227f5bc-b31a-4569-974f-fbdc65eb2429",
			"fileName": "a227f5bc-b31a-4569-974f-fbdc65eb2429",
			"cellName": "Create DIA Source and Load PDB - module.cpp:L1402-1425",
			"cellId": "a227f5bc-b31a-4569-974f-fbdc65eb2429",
			"visible": true,
			"parentCellId": "86ae4575-f412-4af8-88e3-b240b9b18e82"
		},
		"src/dbg/module.cpp-simstep-96effe84-c9f7-4d18-8f6b-cfe5078c735d": {
			"path": "src/dbg/module.cpp-simstep-96effe84-c9f7-4d18-8f6b-cfe5078c735d",
			"fileName": "module.cpp",
			"wiki": "`MODINFO::loadSymbols` instantiates a `SymbolSourceDIA` object, which is responsible for handling PDB files using the Debug Interface Access (DIA) SDK. It then calls the `loadPDB` method to begin parsing.",
			"cellName": "Create DIA Source and Load PDB - module.cpp:L1402-1425",
			"cellId": "a227f5bc-b31a-4569-974f-fbdc65eb2429",
			"visible": true,
			"startLine": 1402,
			"endLine": 1425,
