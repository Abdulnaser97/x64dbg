		"How memory viewing and patching works": {
			"name": "How memory viewing and patching works",
			"simSteps": [
				{
					"simStepId": "cbed7076-7d95-4173-9254-fb0f8274ebad",
					"diagramNodeId": "6da28892-61dd-46ba-8af9-36eed85ea174",
					"simStepLabel": "Memory Map View: Display Memory Regions",
					"simStepDescription": "When the debugger is paused, the Memory Map View is automatically updated. The `stateChangedSlot` is triggered, which calls `refreshMapSlot` to fetch the latest memory map from the debugger core.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/MemoryMapView.cpp",
						"startLine": "580",
						"endLine": "584",
						"relevantVariables": [
							"stateChangedSlot",
							"refreshMapSlot"
						]
					},
					"inputDataExample": "{\"state\": \"paused\"}",
					"outputDataExample": "{}"
				},
				{
					"simStepId": "e7f4d513-e0ea-48d5-a662-d0307b5278cc",
					"diagramNodeId": "29b1b57d-e6e8-4def-b0c1-bf0421c30c86",
					"simStepLabel": "Request Memory Map from Debugger Core",
					"simStepDescription": "The GUI requests the complete memory map of the debugged process from the debugger core via a bridge function.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/MemoryMapView.cpp",
						"startLine": "478",
						"endLine": "478",
						"relevantVariables": [
