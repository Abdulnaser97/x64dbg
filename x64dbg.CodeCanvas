			]
		},
		"8b0ff6f8-d56f-4cfa-980d-56fe4dcf2c8c": {
			"path": "8b0ff6f8-d56f-4cfa-980d-56fe4dcf2c8c",
			"fileName": "8b0ff6f8-d56f-4cfa-980d-56fe4dcf2c8c",
			"cellName": "Download PDB and Initiate Load - symbolinfo.cpp:L198-354",
			"cellId": "8b0ff6f8-d56f-4cfa-980d-56fe4dcf2c8c",
			"visible": true,
			"parentCellId": "531a79c1-0cd3-4004-90b8-3f3fc8989410"
		},
		"src/dbg/symbolinfo.cpp-simstep-657ccbcc-6a7c-42ad-a219-fce898eee9c5": {
			"path": "src/dbg/symbolinfo.cpp-simstep-657ccbcc-6a7c-42ad-a219-fce898eee9c5",
			"fileName": "symbolinfo.cpp",
			"wiki": "`SymDownloadSymbol` constructs the download URL, downloads the PDB file using the `downslib` library, and if successful, calls `MODINFO::loadSymbols` to process the downloaded PDB file.",
			"cellName": "Download PDB and Initiate Load - symbolinfo.cpp:L198-354",
			"cellId": "8b0ff6f8-d56f-4cfa-980d-56fe4dcf2c8c",
