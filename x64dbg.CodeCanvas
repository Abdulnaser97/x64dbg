		"src/gui/Src/Gui/CPUStack.cpp-simstep-0967cde1-1b11-4704-9e74-bd8ccd84b9cb": {
			"path": "src/gui/Src/Gui/CPUStack.cpp-simstep-0967cde1-1b11-4704-9e74-bd8ccd84b9cb",
			"fileName": "CPUStack.cpp",
			"wiki": "The `CPUStack::updateSlot` is triggered, which calls `DbgFunctions()->GetCallStack()` to retrieve call stack frames. Both `CPUStack` and `CPUDump` then read memory from the debuggee using their internal `MemoryPage` objects to refresh their content.",
			"cellName": "Fetch and Render Stack and Memory Dumps - CPUStack.cpp:L574-602",
			"cellId": "d4e98c5b-dcde-4c5c-9ea2-631033010b03",
			"visible": true,
			"startLine": 574,
			"endLine": 602,
			"parentCellId": "97128234-4a11-4f01-913c-c25ba655fa11",
			"parentPath": "src/gui/Src/Gui/CPUStack.cpp",
			"simSteps": [
				{
					"simulationKey": "How inspecting program state works",
					"simStepId": "0967cde1-1b11-4704-9e74-bd8ccd84b9cb"
				}
			]
		},
