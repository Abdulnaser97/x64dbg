		"80dfedcd-fa3a-4bc1-85b6-ad7c932e3f32": {
			"path": "80dfedcd-fa3a-4bc1-85b6-ad7c932e3f32",
			"fileName": "80dfedcd-fa3a-4bc1-85b6-ad7c932e3f32",
			"cellName": "Backend: X-Ref Analysis - _exports.cpp:L102-889",
			"cellId": "80dfedcd-fa3a-4bc1-85b6-ad7c932e3f32",
			"visible": true,
			"parentCellId": "29a4057e-b0a1-47ae-8010-f61559b680a1"
