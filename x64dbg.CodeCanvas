		"b8dab04d-9813-4d45-95eb-34ca981be919": {
			"path": "b8dab04d-9813-4d45-95eb-34ca981be919",
			"fileName": "b8dab04d-9813-4d45-95eb-34ca981be919",
			"cellName": "Start: Display Disassembly in Graph View - DisassemblerGraphView.cpp:L2058",
			"cellId": "b8dab04d-9813-4d45-95eb-34ca981be919",
			"visible": true,
			"parentCellId": "a2515494-8e4d-4df9-9ea6-5534c327fe4c"
		},
		"src/gui/Src/Gui/DisassemblerGraphView.cpp-simstep-f3fd3323-ca77-43f8-8332-a44ca4ebea30": {
			"path": "src/gui/Src/Gui/DisassemblerGraphView.cpp-simstep-f3fd3323-ca77-43f8-8332-a44ca4ebea30",
			"fileName": "DisassemblerGraphView.cpp",
			"wiki": "The process begins when the DisassemblerGraphView needs to display a control flow graph. It iterates through the basic blocks and instructions provided by the backend's control flow analysis. For each instruction's machine code, it calls `disasm.DisassembleAt` to get a structured and tokenized representation for rendering.",
			"cellName": "Start: Display Disassembly in Graph View - DisassemblerGraphView.cpp:L2058",
			"cellId": "b8dab04d-9813-4d45-95eb-34ca981be919",
			"visible": true,
			"startLine": 2058,
			"endLine": 2058,
			"parentCellId": "a2515494-8e4d-4df9-9ea6-5534c327fe4c",
			"parentPath": "src/gui/Src/Gui/DisassemblerGraphView.cpp",
			"simSteps": [
				{
					"simulationKey": "How code analysis and navigation works",
					"simStepId": "f3fd3323-ca77-43f8-8332-a44ca4ebea30"
				}
			]
		},
		"00fcf01c-98b2-43cd-b77d-d6b71565d1dd": {
			"path": "00fcf01c-98b2-43cd-b77d-d6b71565d1dd",
			"fileName": "00fcf01c-98b2-43cd-b77d-d6b71565d1dd",
			"cellName": "Tokenization: QZydis Invokes ZydisTokenizer - QZydis.cpp:L200",
			"cellId": "00fcf01c-98b2-43cd-b77d-d6b71565d1dd",
			"visible": true,
			"parentCellId": "2c98c6b5-56ba-4c94-8dcf-ffb30a598dec"
		},
		"src/gui/Src/Disassembler/QZydis.cpp-simstep-265caf94-f778-48fc-aff8-69cf52c08991": {
			"path": "src/gui/Src/Disassembler/QZydis.cpp-simstep-265caf94-f778-48fc-aff8-69cf52c08991",
			"fileName": "QZydis.cpp",
			"wiki": "`QZydis` is a Qt-level wrapper that delegates the tokenization process to its internal `ZydisTokenizer` instance. The tokenizer's role is to convert raw instruction bytes into a series of styled tokens for syntax highlighting.",
			"cellName": "Tokenization: QZydis Invokes ZydisTokenizer - QZydis.cpp:L200",
			"cellId": "00fcf01c-98b2-43cd-b77d-d6b71565d1dd",
			"visible": true,
			"startLine": 200,
			"endLine": 200,
			"parentCellId": "2c98c6b5-56ba-4c94-8dcf-ffb30a598dec",
			"parentPath": "src/gui/Src/Disassembler/QZydis.cpp",
			"simSteps": [
				{
					"simulationKey": "How code analysis and navigation works",
					"simStepId": "265caf94-f778-48fc-aff8-69cf52c08991"
				}
			]
		},
		"f4af227c-f71f-4748-a20e-b12b64376074": {
			"path": "f4af227c-f71f-4748-a20e-b12b64376074",
			"fileName": "f4af227c-f71f-4748-a20e-b12b64376074",
			"cellName": "Disassembly: ZydisTokenizer uses Zydis Wrapper - ZydisTokenizer.cpp:L136",
			"cellId": "f4af227c-f71f-4748-a20e-b12b64376074",
			"visible": true,
			"parentCellId": "12d1d631-dfd0-4fcb-a4f0-cdd0ff5a4c2a"
		},
		"src/gui/Src/Disassembler/ZydisTokenizer.cpp-simstep-831619c1-3251-4112-b846-517140a635c3": {
			"path": "src/gui/Src/Disassembler/ZydisTokenizer.cpp-simstep-831619c1-3251-4112-b846-517140a635c3",
			"fileName": "ZydisTokenizer.cpp",
			"wiki": "The tokenizer uses its `Zydis` member object, a C++ wrapper around the core Zydis library, to perform the actual machine code disassembly. It calls `DisassembleSafe` which handles potential read errors.",
			"cellName": "Disassembly: ZydisTokenizer uses Zydis Wrapper - ZydisTokenizer.cpp:L136",
			"cellId": "f4af227c-f71f-4748-a20e-b12b64376074",
			"visible": true,
			"startLine": 136,
			"endLine": 136,
			"parentCellId": "12d1d631-dfd0-4fcb-a4f0-cdd0ff5a4c2a",
			"parentPath": "src/gui/Src/Disassembler/ZydisTokenizer.cpp",
			"simSteps": [
				{
					"simulationKey": "How code analysis and navigation works",
