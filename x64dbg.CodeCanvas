						]
					},
					"inputDataExample": "{\"event\": \"CREATE_PROCESS_DEBUG_EVENT\", \"processId\": 1234, \"threadId\": 5678, \"baseOfImage\": \"0x400000\"}",
					"outputDataExample": "{\"event\": \"CREATE_PROCESS_DEBUG_EVENT\", \"processId\": 1234, \"threadId\": 5678, \"baseOfImage\": \"0x400000\"}"
				},
				{
					"simStepId": "e95b1ee2-4604-429f-a351-2ed94884384e",
					"diagramNodeId": "d7ace5b1-8e14-4935-b227-3199ab50da58",
					"simStepLabel": "Core Event Handler Invokes Plugin Callbacks",
					"simStepDescription": "The debugger's core handler for process creation, 'cbCreateProcess', prepares a 'PLUG_CB_CREATEPROCESS' struct with event details and then calls 'plugincbcall' to notify all interested plugins.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "1633",
						"endLine": "1633",
						"relevantVariables": [
							"plugincbcall",
							"CB_CREATEPROCESS",
							"callbackInfo"
						]
					},
					"inputDataExample": "{\"CreateProcessInfo\": {\"lpBaseOfImage\": \"0x400000\"}}",
					"outputDataExample": "{\"callbackInfo\": {\"CreateProcessInfo\": {\"lpBaseOfImage\": \"0x400000\"}, \"DebugFileName\": \"C:\\\\path\\\\to\\\\debuggee.exe\"}}"
				},
				{
					"simStepId": "cc37893f-7f96-474a-8a2b-592bfe614b43",
					"diagramNodeId": "fcad5ebe-7375-4680-b92c-755b17f872b4",
					"simStepLabel": "Dispatch to Registered Callbacks",
					"simStepDescription": "The 'plugincbcall' function is the central dispatcher. It looks up the list of callbacks registered for 'CB_CREATEPROCESS' and prepares to call them.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/plugin_loader.h",
						"startLine": "78",
						"endLine": "78",
						"relevantVariables": [
							"plugincbcall",
							"CBTYPE"
						]
					},
					"inputDataExample": "{\"cbType\": \"CB_CREATEPROCESS\", \"callbackInfo\": {\"DebugFileName\": \"C:\\\\path\\\\to\\\\debuggee.exe\"}}",
					"outputDataExample": "{\"cbType\": \"CB_CREATEPROCESS\", \"callbackInfo\": {\"DebugFileName\": \"C:\\\\path\\\\to\\\\debuggee.exe\"}}"
				},
				{
					"simStepId": "a51f1397-be56-472c-b3a0-96942f9dcf33",
					"diagramNodeId": "ca042f1e-b507-48c1-ad72-0891bc887187",
					"simStepLabel": "Execute Plugin Callback Handler",
					"simStepDescription": "The 'plugincbcall' function iterates through the list and invokes the function pointer that 'mytracer' plugin registered earlier, passing the event data struct.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/plugin_loader.cpp",
						"startLine": "683",
						"endLine": "692",
						"relevantVariables": [
							"plugincbcall",
							"gPluginCallbackList",
							"cbList"
						]
					},
					"inputDataExample": "{\"cbType\": \"CB_CREATEPROCESS\", \"callbackInfo\": {\"DebugFileName\": \"C:\\\\path\\\\to\\\\debuggee.exe\"}}",
					"outputDataExample": "null"
				},
				{
					"simStepId": "f2498ccc-16b5-4fa1-a738-ac412cc8f505",
					"diagramNodeId": "922e7ea1-2ead-43f0-988d-26fa034dacdd",
					"simStepLabel": "Plugin Receives Event Data",
					"simStepDescription": "Control is transferred to the plugin's callback function. The plugin now has access to the 'PLUG_CB_CREATEPROCESS' data structure and can perform its custom logic.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/_plugins.h",
						"startLine": "310",
						"endLine": "310",
						"relevantVariables": [
