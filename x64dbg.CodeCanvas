		"src/dbg/pdbdiafile.cpp-simstep-fae0bf1a-b24a-4b18-98f0-862dc1cc1803": {
			"path": "src/dbg/pdbdiafile.cpp-simstep-fae0bf1a-b24a-4b18-98f0-862dc1cc1803",
			"fileName": "pdbdiafile.cpp",
			"wiki": "`PDBDiaFile::enumerateLexicalHierarchy` uses the DIA SDK interfaces (`IDiaSession`, `IDiaSymbol`, `IDiaEnumSymbols`) to find and iterate through all symbols (publics, functions, data, etc.) within the PDB file.",
			"cellName": "Enumerate Symbols with DIA SDK - pdbdiafile.cpp:L570-673",
			"cellId": "ede633c5-30b4-4117-b09f-c63ef9c89843",
			"visible": true,
