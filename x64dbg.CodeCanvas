		"How breakpoint management works": {
			"name": "How breakpoint management works",
			"simSteps": [
				{
					"simStepId": "e80bc54b-5560-4ff8-b85c-9351e12616b1",
					"diagramNodeId": "080808e0-43c2-458a-aadb-72d4c4f04d5a",
					"simStepLabel": "Software Breakpoint: User issues 'bp' command",
					"simStepDescription": "The user initiates the process by typing the 'bp' (Set Breakpoint) command into the x64dbg command bar to set a standard software breakpoint at a specific memory address.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/x64dbg.cpp",
						"startLine": "167",
						"endLine": "167",
						"relevantVariables": [
							"dbgcmdnew",
							"cbDebugSetBPX"
						]
					},
					"inputDataExample": "{\"command\": \"bp 0x401000\"}",
					"outputDataExample": "{\"argc\": 2, \"argv\": [\"bp\", \"0x401000\"]}"
				},
				{
					"simStepId": "0e194e37-a2cb-4653-9a0d-e1feea49405c",
					"diagramNodeId": "e97f3f2c-78a6-4fb8-b2fa-5f4a2d58acfa",
					"simStepLabel": "Software Breakpoint: Dispatch to Command Handler",
					"simStepDescription": "The command parser identifies the 'bp' command and dispatches it, along with its arguments, to the registered callback function 'cbDebugSetBPX'.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/x64dbg.cpp",
						"startLine": "167",
						"endLine": "167",
						"relevantVariables": [
							"cbDebugSetBPX"
						]
					},
					"inputDataExample": "{\"argc\": 2, \"argv\": [\"bp\", \"0x401000\"]}",
					"outputDataExample": "{\"argc\": 2, \"argv\": [\"bp\", \"0x401000\"]}"
				},
				{
					"simStepId": "706d376e-62c3-4c70-b42e-0c7d3eae01b6",
					"diagramNodeId": "12376617-ce26-4000-8497-aa32c74c00f8",
					"simStepLabel": "Software Breakpoint: `cbDebugSetBPX` Execution",
					"simStepDescription": "This function handles the logic for the 'bp' command. It parses the address, checks for existing breakpoints, reads the original bytes at the target address, creates an internal breakpoint structure, and calls the debugger core to set the breakpoint.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-breakpoint-control.cpp",
						"startLine": "65",
						"endLine": "145",
						"relevantVariables": [
							"cbDebugSetBPX",
							"valfromstring",
							"BpGet",
							"IsBPXEnabled",
							"MemRead",
							"BpNew",
							"SetBPX"
						]
					},
					"inputDataExample": "{\"argc\": 2, \"argv\": [\"bp\", \"0x401000\"]}",
					"outputDataExample": "{\"addr\": \"0x401000\", \"type\": 8, \"singleshoot\": false, \"oldbytes\": 23141}"
				},
				{
					"simStepId": "4833e911-a359-4edb-9717-75b16eff2048",
					"diagramNodeId": "f3a7a3b5-f251-4cd4-8293-793f12cb9acb",
					"simStepLabel": "Software Breakpoint: Create Internal Breakpoint Record",
					"simStepDescription": "The `cbDebugSetBPX` handler calls `BpNew` to create and register a new BREAKPOINT structure in the debugger's internal management system.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-breakpoint-control.cpp",
						"startLine": "127",
						"endLine": "131",
						"relevantVariables": [
							"BpNew"
						]
					},
					"inputDataExample": "{\"Address\": \"0x401000\", \"Enable\": true, \"Singleshot\": false, \"OldBytes\": 23141, \"Type\": \"BPNORMAL\", \"TitanType\": 0, \"Name\": \"\", \"memsize\": 0}",
					"outputDataExample": "{\"Address\": \"0x401000\", \"Enable\": true, \"Singleshot\": false, \"OldBytes\": 23141, \"Type\": \"BPNORMAL\", \"TitanType\": 0, \"Name\": \"\", \"memsize\": 0}"
				},
				{
					"simStepId": "01a1efc9-d0d8-439b-b047-69b093313a0f",
					"diagramNodeId": "52a5928c-1b8d-4748-8324-022a0618d0db",
					"simStepLabel": "Software Breakpoint: BpNew Adds to Internal List",
