		"ca58fa66-7793-4311-a779-9b8709768fa8": {
			"path": "ca58fa66-7793-4311-a779-9b8709768fa8",
			"fileName": "ca58fa66-7793-4311-a779-9b8709768fa8",
			"cellName": "Load Plugin DLL - plugin_loader.cpp:L208-214",
			"cellId": "ca58fa66-7793-4311-a779-9b8709768fa8",
			"visible": true,
			"parentCellId": "232037a5-31e9-427c-abd5-539ebafaad95"
