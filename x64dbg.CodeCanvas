		"src/dbg/commands/cmd-breakpoint-control.cpp-simstep-706d376e-62c3-4c70-b42e-0c7d3eae01b6": {
			"path": "src/dbg/commands/cmd-breakpoint-control.cpp-simstep-706d376e-62c3-4c70-b42e-0c7d3eae01b6",
			"fileName": "cmd-breakpoint-control.cpp",
			"wiki": "This function handles the logic for the 'bp' command. It parses the address, checks for existing breakpoints, reads the original bytes at the target address, creates an internal breakpoint structure, and calls the debugger core to set the breakpoint.",
			"cellName": "Software Breakpoint: `cbDebugSetBPX` Execution - cmd-breakpoint-control.cpp:L65-145",
			"cellId": "12376617-ce26-4000-8497-aa32c74c00f8",
			"visible": true,
			"startLine": 65,
