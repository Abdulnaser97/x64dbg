			"path": "src/dbg/commands/cmd-analysis.cpp-simstep-1a8c2641-f10d-4d28-8979-bb507e3bc52f",
			"fileName": "cmd-analysis.cpp",
			"wiki": "The debugger core receives the command, and the registered handler `cbDebugDownloadSymbol` is executed. It determines which module(s) to download symbols for based on the provided arguments.",
			"cellName": "Process 'symdownload' Command - cmd-analysis.cpp:L182-204",
			"cellId": "8e1fac20-eb34-4f36-a58e-1caddb899802",
			"visible": true,
