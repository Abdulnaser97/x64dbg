		"src/dbg/symbolsourcedia.cpp-simstep-8de1ecf9-eeba-49fc-8617-9e451ebfff27": {
			"path": "src/dbg/symbolsourcedia.cpp-simstep-8de1ecf9-eeba-49fc-8617-9e451ebfff27",
			"fileName": "symbolsourcedia.cpp",
			"wiki": "`SymbolSourceDIA` receives the raw symbol data, converts it to its internal `SymbolInfo` format, and stores it in a vector (`_symData`). After enumeration, it creates sorted maps for fast lookups by both address and name.",
			"cellName": "Cache and Index Symbols - symbolsourcedia.cpp:L173-237",
			"cellId": "f2deb9df-dc31-40dd-80ea-14512e43aca8",
			"visible": true,
