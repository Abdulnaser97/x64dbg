		"src/dbg/plugin_loader.cpp-simstep-46b6fff6-8154-4c0d-a132-04842be6d16d": {
			"path": "src/dbg/plugin_loader.cpp-simstep-46b6fff6-8154-4c0d-a132-04842be6d16d",
			"fileName": "plugin_loader.cpp",
			"wiki": "The 'pluginload' function is the core of the plugin loading mechanism. It resolves the full path to the plugin's DLL file and loads it into the debugger's process space using the Windows API 'LoadLibraryW'.",
			"cellName": "Load Plugin DLL - plugin_loader.cpp:L208-214",
			"cellId": "ca58fa66-7793-4311-a779-9b8709768fa8",
			"visible": true,
			"startLine": 208,
			"endLine": 214,
