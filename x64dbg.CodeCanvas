		"src/dbg/_plugins.h-simstep-38eca4be-07d8-499c-95c3-8b7875579a43": {
			"path": "src/dbg/_plugins.h-simstep-38eca4be-07d8-499c-95c3-8b7875579a43",
			"fileName": "_plugins.h",
			"wiki": "The plugin's specific code for the 'CB_CREATEPROCESS' event runs. For example, it might log the process name, set initial breakpoints, or perform other analysis tasks. Once the function returns, control goes back to the debugger.",
			"cellName": "Plugin Executes Custom Logic - _plugins.h:L76-82",
			"cellId": "a5c8ff15-898a-410e-b123-6603f5fa3ac8",
			"visible": true,
