		"src/gui/Src/Gui/SymbolView.cpp-simstep-c987c75d-348c-4519-86e5-3d09054cd583": {
			"path": "src/gui/Src/Gui/SymbolView.cpp-simstep-c987c75d-348c-4519-86e5-3d09054cd583",
			"fileName": "SymbolView.cpp",
			"wiki": "In the GUI, the user clicks on a module in the module list within the `SymbolView`. This triggers the `moduleSelectionChanged` slot, initiating the process to display symbols for that module.",
			"cellName": "User Selects Module in Symbol View - SymbolView.cpp:L442-480",
			"cellId": "6ddf81a6-a48a-4adf-b982-a6257239bbe0",
