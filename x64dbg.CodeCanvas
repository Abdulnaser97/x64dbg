				},
				{
					"simStepId": "6e0cfba6-9b66-4cd1-a7f1-15403953510c",
					"diagramNodeId": "1ebaf283-3a05-4272-a7be-00f0e06cbe03",
					"simStepLabel": "Delete Breakpoint: Remove Internal Breakpoint Record",
					"simStepDescription": "The `cbDebugDeleteBPX` handler calls `BpDelete` to find and remove the `BREAKPOINT` structure from the debugger's internal management system.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-breakpoint-control.cpp",
						"startLine": "190",
						"endLine": "194",
						"relevantVariables": [
							"BpDelete"
						]
					},
					"inputDataExample": "{\"Address\": \"0x401000\", \"Type\": \"BPNORMAL\"}",
					"outputDataExample": "{\"Address\": \"0x401000\", \"Type\": \"BPNORMAL\"}"
				},
				{
					"simStepId": "894ca3a7-98b1-4f9d-9f7b-6450947bd30a",
					"diagramNodeId": "858e2562-2b4f-497b-9598-18d88759782b",
					"simStepLabel": "Delete Breakpoint: BpDelete Removes from Internal List",
					"simStepDescription": "The `BpDelete` function finds the specified breakpoint in the global 'breakpoints' map and erases it.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/breakpoint.cpp",
						"startLine": "336",
						"endLine": "346",
						"relevantVariables": [
							"BpDelete",
							"safeDelete",
							"breakpoints"
						]
					},
					"inputDataExample": "{\"Address\": \"0x401000\", \"Type\": \"BPNORMAL\"}",
					"outputDataExample": "{\"success\": true}"
				},
				{
					"simStepId": "74529f09-962e-46bd-8dc3-0338d0b24bfb",
					"diagramNodeId": "63904c58-4525-43b1-b392-760fdce2a0d1",
					"simStepLabel": "Delete Breakpoint: Call TitanEngine to Restore Memory",
					"simStepDescription": "After removing the internal record, the handler calls `DeleteBPX` from the TitanEngine core to restore the original byte(s) at the breakpoint's address, effectively removing the `INT3` instruction.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-breakpoint-control.cpp",
						"startLine": "195",
						"endLine": "202",
						"relevantVariables": [
							"DeleteBPX"
						]
					},
					"inputDataExample": "{\"addr\": \"0x401000\"}",
					"outputDataExample": "{\"addr\": \"0x401000\"}"
				},
				{
					"simStepId": "4f133440-9681-44eb-935d-bc334d734d76",
					"diagramNodeId": "4aef6275-ff92-45af-aaec-ff3a447f6f51",
					"simStepLabel": "Delete Breakpoint: TitanEngine's `DeleteBPX` Restores Memory",
					"simStepDescription": "The TitanEngine core function `DeleteBPX` looks up the breakpoint, retrieves the original byte it saved, and writes it back to the debuggee's memory, removing the software breakpoint.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/TitanEngine/TitanEngine.txt",
						"startLine": "2799",
						"endLine": "2812",
						"relevantVariables": [
							"DeleteBPX"
						]
					},
					"inputDataExample": "{\"addr\": \"0x401000\"}",
					"outputDataExample": "{\"success\": true}"
				},
				{
					"simStepId": "3cb701b7-15d2-4755-a6fc-380c8020a060",
					"diagramNodeId": "a4e94844-ded9-4dc8-ad5c-85ad6f0c8de3",
					"simStepLabel": "Delete Breakpoint: Signal GUI Update",
					"simStepDescription": "Finally, `GuiUpdateAllViews` is called to notify the UI that the breakpoint list has changed and needs to be refreshed.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-breakpoint-control.cpp",
						"startLine": "204",
						"endLine": "204",
						"relevantVariables": [
							"GuiUpdateAllViews"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{}"
				},
				{
					"simStepId": "0e382195-981d-4d10-87f3-19e059565802",
					"diagramNodeId": "015da653-3fc8-4e2d-a6d4-376e14b081b2",
					"simStepLabel": "Delete Breakpoint: Breakpoints View Refreshes",
					"simStepDescription": "The Breakpoints view receives the update signal, fetches the new breakpoint list, and updates its display to show that the breakpoint has been removed.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/BreakpointsView.cpp",
						"startLine": "216",
						"endLine": "579",
						"relevantVariables": [
							"updateBreakpointsSlot",
							"DbgFunctions()->BpRefList"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{\"breakpoints\": []}"
				}
			],
			"description": "<ul><li>- Users can set breakpoints to pause execution at a specific address or upon certain events</li><li>- x64dbg supports software breakpoints (INT3), hardware breakpoints (on execution, access, or write using debug registers), and memory breakpoints (on page access)</li><li>- The <code>breakpoint</li><li>cpp</code> file manages the internal list of all breakpoint types, handling their creation, deletion, and state (enabled/disabled)</li><li>- Conditional breakpoints can be set with expressions that are evaluated when the breakpoint is hit, only pausing if the condition is true</li></ul>",
