		"aaafc0a9-b260-43f6-92ca-64748c4dca4a": {
			"path": "aaafc0a9-b260-43f6-92ca-64748c4dca4a",
			"fileName": "aaafc0a9-b260-43f6-92ca-64748c4dca4a",
			"cellName": "Debugger Paused: GUI Update Initiated - bridgemain.cpp:L1694-1698",
			"cellId": "aaafc0a9-b260-43f6-92ca-64748c4dca4a",
			"visible": true,
			"parentCellId": "34a51fba-5159-4b03-9b29-f12688141535"
		},
		"src/bridge/bridgemain.cpp-simstep-0a1399a9-b30c-4a9f-84e5-60f34cf3c83c": {
			"path": "src/bridge/bridgemain.cpp-simstep-0a1399a9-b30c-4a9f-84e5-60f34cf3c83c",
			"fileName": "bridgemain.cpp",
			"wiki": "When the debuggee pauses, the debugger core triggers a refresh of the user interface. This process starts in the bridge component, which calls individual update functions for different parts of the GUI, beginning with the register view.",
			"cellName": "Debugger Paused: GUI Update Initiated - bridgemain.cpp:L1694-1698",
			"cellId": "aaafc0a9-b260-43f6-92ca-64748c4dca4a",
			"visible": true,
			"startLine": 1694,
			"endLine": 1698,
			"parentCellId": "34a51fba-5159-4b03-9b29-f12688141535",
			"parentPath": "src/bridge/bridgemain.cpp",
			"simSteps": [
				{
					"simulationKey": "How inspecting program state works",
					"simStepId": "0a1399a9-b30c-4a9f-84e5-60f34cf3c83c"
				}
			]
		},
		"a7a45aa5-81b1-4110-90f5-5d2788ed7abd": {
			"path": "a7a45aa5-81b1-4110-90f5-5d2788ed7abd",
			"fileName": "a7a45aa5-81b1-4110-90f5-5d2788ed7abd",
			"cellName": "Bridge Processes Message and Emits Signal - Bridge.cpp:L117-119",
			"cellId": "a7a45aa5-81b1-4110-90f5-5d2788ed7abd",
			"visible": true,
			"parentCellId": "3976d383-acfe-4757-b0df-90b5b7e7f052"
		},
		"src/gui/Src/Bridge/Bridge.cpp-simstep-9d817ead-f677-494b-987d-9b12cfb5982c": {
			"path": "src/gui/Src/Bridge/Bridge.cpp-simstep-9d817ead-f677-494b-987d-9b12cfb5982c",
			"fileName": "Bridge.cpp",
			"wiki": "The main GUI bridge receives the `GUI_UPDATE_REGISTER_VIEW` message. It processes this message and, to avoid overwhelming the UI with rapid updates, uses a throttling mechanism. It then emits a Qt signal, `updateRegisters()`, to notify the relevant UI components.",
			"cellName": "Bridge Processes Message and Emits Signal - Bridge.cpp:L117-119",
			"cellId": "a7a45aa5-81b1-4110-90f5-5d2788ed7abd",
			"visible": true,
			"startLine": 117,
			"endLine": 119,
			"parentCellId": "3976d383-acfe-4757-b0df-90b5b7e7f052",
			"parentPath": "src/gui/Src/Bridge/Bridge.cpp",
			"simSteps": [
				{
					"simulationKey": "How inspecting program state works",
					"simStepId": "9d817ead-f677-494b-987d-9b12cfb5982c"
				}
			]
		},
		"97f7adb1-6a2c-4a44-936f-fbdb045482e4": {
			"path": "97f7adb1-6a2c-4a44-936f-fbdb045482e4",
			"fileName": "97f7adb1-6a2c-4a44-936f-fbdb045482e4",
			"cellName": "Fetch Register Data - CPURegistersView.cpp:L203-212",
			"cellId": "97f7adb1-6a2c-4a44-936f-fbdb045482e4",
			"visible": true,
			"parentCellId": "d60bfce0-87c7-458e-95c6-0bc5215bd8c4"
		},
		"src/gui/Src/Gui/CPURegistersView.cpp-simstep-4b7620fe-edfc-4066-ad83-e0fee68d4481": {
			"path": "src/gui/Src/Gui/CPURegistersView.cpp-simstep-4b7620fe-edfc-4066-ad83-e0fee68d4481",
			"fileName": "CPURegistersView.cpp",
			"wiki": "The `updateRegistersSlot` in `CPURegistersView` is executed. It calls the `DbgGetRegDumpEx` function to request the complete register state from the debugger core.",
			"cellName": "Fetch Register Data - CPURegistersView.cpp:L203-212",
			"cellId": "97f7adb1-6a2c-4a44-936f-fbdb045482e4",
			"visible": true,
			"startLine": 203,
			"endLine": 212,
			"parentCellId": "d60bfce0-87c7-458e-95c6-0bc5215bd8c4",
			"parentPath": "src/gui/Src/Gui/CPURegistersView.cpp",
			"simSteps": [
				{
					"simulationKey": "How inspecting program state works",
					"simStepId": "4b7620fe-edfc-4066-ad83-e0fee68d4481"
				}
			]
		},
		"421f4f68-9407-47fb-9d47-14d673311c38": {
			"path": "421f4f68-9407-47fb-9d47-14d673311c38",
			"fileName": "421f4f68-9407-47fb-9d47-14d673311c38",
			"cellName": "Render Register View - CPURegistersView.cpp:L209-211",
			"cellId": "421f4f68-9407-47fb-9d47-14d673311c38",
			"visible": true,
			"parentCellId": "d60bfce0-87c7-458e-95c6-0bc5215bd8c4"
		},
		"src/gui/Src/Gui/CPURegistersView.cpp-simstep-e8c14476-191c-4307-abdb-b944b0751546": {
			"path": "src/gui/Src/Gui/CPURegistersView.cpp-simstep-e8c14476-191c-4307-abdb-b944b0751546",
			"fileName": "CPURegistersView.cpp",
			"wiki": "The `REGDUMP_AVX512` structure containing the register data is returned to `CPURegistersView`. The `setRegisters` method is then called to parse this structure and update the labels in the UI, highlighting any registers that have changed.",
			"cellName": "Render Register View - CPURegistersView.cpp:L209-211",
			"cellId": "421f4f68-9407-47fb-9d47-14d673311c38",
			"visible": true,
			"startLine": 209,
			"endLine": 211,
			"parentCellId": "d60bfce0-87c7-458e-95c6-0bc5215bd8c4",
			"parentPath": "src/gui/Src/Gui/CPURegistersView.cpp",
			"simSteps": [
				{
					"simulationKey": "How inspecting program state works",
					"simStepId": "e8c14476-191c-4307-abdb-b944b0751546"
				}
			]
		},
		"5f89b73b-b1c8-4126-8b4c-41012e6bf958": {
			"path": "5f89b73b-b1c8-4126-8b4c-41012e6bf958",
			"fileName": "5f89b73b-b1c8-4126-8b4c-41012e6bf958",
