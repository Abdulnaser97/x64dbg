		"src/dbg/TitanEngine/TitanEngine.txt-simstep-745cd9ea-771e-4b7e-bb6b-88b60f0f96a7": {
			"path": "src/dbg/TitanEngine/TitanEngine.txt-simstep-745cd9ea-771e-4b7e-bb6b-88b60f0f96a7",
			"fileName": "TitanEngine.txt",
			"wiki": "The TitanEngine core function `SetBPX` saves the original byte at the specified address and overwrites it with an INT3 (0xCC) instruction, effectively setting the software breakpoint.",
			"cellName": "Software Breakpoint: TitanEngine's `SetBPX` Patches Memory - TitanEngine.txt:L2470-2486",
			"cellId": "be00a6ef-cf1d-4356-a55f-888c881f1329",
			"visible": true,
			"startLine": 2470,
			"endLine": 2486,
			"parentCellId": "ee9eb810-2328-432a-a440-253dd1f0a1c8",
			"parentPath": "src/dbg/TitanEngine/TitanEngine.txt",
			"simSteps": [
