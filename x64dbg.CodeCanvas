	"simulations": {
		"How debug execution control works": {
			"name": "How debug execution control works",
			"simSteps": [
				{
					"simStepId": "f98baeed-d375-4f25-aad2-dbd6f4913d36",
					"diagramNodeId": "0f8c9945-3ad2-4bd9-9dfa-448966a3bc58",
					"simStepLabel": "Flow: Init Debug - User Issues 'init' Command",
					"simStepDescription": "The debug session is initiated when the user executes the 'init' command, providing the path to an executable. This command is registered by the debugger core to a callback function that handles process creation.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/x64dbg.cpp",
						"startLine": "144",
						"endLine": "144",
						"relevantVariables": [
							"registercommands",
							"dbgcmdnew",
							"cbDebugInit"
						]
					},
					"inputDataExample": "{\n  \"command\": \"init \\\"C:\\\\path\\\\to\\\\program.exe\\\"\"\n}",
					"outputDataExample": "{\n  \"command\": \"init\",\n  \"arguments\": [\n    \"C:\\\\path\\\\to\\\\program.exe\"\n  ]\n}"
				},
				{
					"simStepId": "d5c5a137-4a8a-4fa1-ab45-0fdea5017883",
					"diagramNodeId": "38a0c204-9826-4d0b-8647-e4021366a88f",
					"simStepLabel": "Flow: Init Debug - Command Dispatch",
					"simStepDescription": "The command and its arguments are parsed and dispatched to the corresponding handler function, `cbDebugInit`.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-debug-control.cpp",
						"startLine": "66",
						"endLine": "66",
						"relevantVariables": [
							"cbDebugInit"
						]
					},
					"inputDataExample": "{\n  \"command\": \"init\",\n  \"arguments\": [\n    \"C:\\\\path\\\\to\\\\program.exe\"\n  ]\n}",
					"outputDataExample": "{\n  \"command\": \"init\",\n  \"arguments\": [\n    \"C:\\\\path\\\\to\\\\program.exe\"\n  ]\n}"
				},
				{
					"simStepId": "3f11e844-015f-4c47-be09-bdc31026f52a",
					"diagramNodeId": "4a02a440-0660-413f-854b-81c571c108ec",
					"simStepLabel": "Flow: Init Debug - Prepare and Create Debug Thread",
					"simStepDescription": "The `cbDebugInit` function resolves the file path, determines the architecture, and prepares an `INIT_STRUCT` with the necessary information. It then calls `dbgcreatedebugthread` to spawn a new thread that will manage the debuggee.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-debug-control.cpp",
						"startLine": "66",
						"endLine": "178",
						"relevantVariables": [
							"cbDebugInit",
							"INIT_STRUCT",
							"init",
							"dbgcreatedebugthread"
						]
					},
					"inputDataExample": "{\n  \"argc\": 2,\n  \"argv\": [\n    \"init\",\n    \"C:\\\\path\\\\to\\\\program.exe\"\n  ]\n}",
					"outputDataExample": "{\n  \"init_struct\": {\n    \"exe\": \"C:\\\\path\\\\to\\\\program.exe\",\n    \"commandline\": \"\",\n    \"currentfolder\": \"C:\\\\path\\\\to\",\n    \"entryPointRva\": 4198400,\n    \"isDll\": false,\n    \"attach\": false\n  }\n}"
				},
				{
					"simStepId": "470ef357-8160-46db-ae30-0d672577e655",
					"diagramNodeId": "72682cb3-b713-4419-8d88-169f13311729",
					"simStepLabel": "Flow: Init Debug - Pass Init Info to Debug Thread",
					"simStepDescription": "The `INIT_STRUCT` is passed as an argument to the newly created debug thread, which executes `debugLoopFunction`.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "2810",
						"endLine": "2810",
						"relevantVariables": [
							"debugLoopFunction"
						]
					},
					"inputDataExample": "{\n  \"init_struct\": {\n    \"exe\": \"C:\\\\path\\\\to\\\\program.exe\",\n    \"commandline\": \"\",\n    \"currentfolder\": \"C:\\\\path\\\\to\",\n    \"entryPointRva\": 4198400,\n    \"isDll\": false,\n    \"attach\": false\n  }\n}",
					"outputDataExample": "{\n  \"init_struct\": {\n    \"exe\": \"C:\\\\path\\\\to\\\\program.exe\",\n    \"commandline\": \"\",\n    \"currentfolder\": \"C:\\\\path\\\\to\",\n    \"entryPointRva\": 4198400,\n    \"isDll\": false,\n    \"attach\": false\n  }\n}"
				},
				{
					"simStepId": "5e7d07a6-2a89-4a76-a69f-a94c35442ef2",
					"diagramNodeId": "2403d3f4-49d5-4786-a20c-589b0ac46e9f",
					"simStepLabel": "Flow: Init Debug - Create Process and Start Debug Loop",
					"simStepDescription": "The `debugLoopFunction` calls `InitDebugW` (from TitanEngine) to create the target process in a suspended state. It then sets up handlers for various debug events (process creation, thread creation, exceptions, etc.) and finally enters the main `DebugLoop`, which waits for OS debug events.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "2859",
						"endLine": "2976",
						"relevantVariables": [
							"debugLoopFunction",
							"InitDebugW",
							"SetCustomHandler",
							"DebugLoop"
						]
					},
					"inputDataExample": "{\n  \"init_struct\": {\n    \"exe\": \"C:\\\\path\\\\to\\\\program.exe\",\n    \"commandline\": \"\",\n    \"currentfolder\": \"C:\\\\path\\\\to\",\n    \"entryPointRva\": 4198400,\n    \"isDll\": false,\n    \"attach\": false\n  }\n}",
					"outputDataExample": "{\n  \"process_information\": {\n    \"hProcess\": \"0x124\",\n    \"hThread\": \"0x128\",\n    \"dwProcessId\": 5000,\n    \"dwThreadId\": 5004\n  }\n}"
				},
				{
					"simStepId": "1bd06100-c64f-4420-b12b-dad14790a6eb",
					"diagramNodeId": "d6ddb188-842f-4e2d-83d3-a97b4288b7fc",
					"simStepLabel": "Flow: Init Debug - System Breakpoint Event",
					"simStepDescription": "After the process is created, the OS triggers a system breakpoint, which is the first event caught by the `DebugLoop`. This event is dispatched to the registered handler.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "2932",
						"endLine": "2932",
						"relevantVariables": [
							"SetCustomHandler",
							"UE_CH_SYSTEMBREAKPOINT",
							"cbSystemBreakpoint"
						]
					},
					"inputDataExample": "{\n  \"DebugEvent\": {\n    \"dwDebugEventCode\": \"EXCEPTION_DEBUG_EVENT\",\n    \"ExceptionRecord\": {\n      \"ExceptionCode\": \"EXCEPTION_BREAKPOINT\"\n    }\n  }\n}",
					"outputDataExample": "{\n  \"DebugEvent\": {\n    \"dwDebugEventCode\": \"EXCEPTION_DEBUG_EVENT\",\n    \"ExceptionRecord\": {\n      \"ExceptionCode\": \"EXCEPTION_BREAKPOINT\"\n    }\n  }\n}"
				},
				{
					"simStepId": "abbeb5e3-5b4b-466b-a5b7-354b3abfaf9d",
					"diagramNodeId": "fc9d372f-58a8-437c-bd78-612c3d1470cd",
					"simStepLabel": "Flow: Init Debug - Handle System Breakpoint and Pause",
					"simStepDescription": "The `cbSystemBreakpoint` callback is executed. It updates the GUI, logs the event, and based on user settings, pauses the debugger by acquiring a lock (`lock(WAITID_RUN)`). The debug loop is now blocked by `wait(WAITID_RUN)`, effectively pausing the debuggee until the user provides a command like 'run' or 'step'.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "1793",
						"endLine": "1841",
						"relevantVariables": [
							"cbSystemBreakpoint",
							"lock",
							"wait",
							"WAITID_RUN"
						]
					},
					"inputDataExample": "null",
					"outputDataExample": "{\n  \"state\": \"paused\",\n  \"wait_id\": \"WAITID_RUN\"\n}"
				},
				{
					"simStepId": "63aa1c5e-eb80-439a-a80d-4fd22ee0630b",
					"diagramNodeId": "53732f1b-0247-441c-b695-22c8f19d13f7",
					"simStepLabel": "Flow: Run - User Issues 'run' Command",
					"simStepDescription": "When the debugger is paused, the user issues the 'run' command (or presses F9). This command is registered to the `cbDebugRun` callback.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/x64dbg.cpp",
						"startLine": "148",
						"endLine": "148",
						"relevantVariables": [
							"dbgcmdnew",
							"cbDebugRun"
						]
					},
					"inputDataExample": "{\n  \"command\": \"run\"\n}",
					"outputDataExample": "{\n  \"command\": \"run\",\n  \"arguments\": []\n}"
				},
				{
					"simStepId": "a20b74b8-cc3a-4b8b-b123-992d88f95e39",
					"diagramNodeId": "51ed8bf5-cf1c-4543-bf2a-4bac4a185adb",
					"simStepLabel": "Flow: Run - Dispatch to Command Handler",
					"simStepDescription": "The command is dispatched to `cbDebugRun`, which in turn calls the internal implementation `cbDebugRunInternal`.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-debug-control.cpp",
						"startLine": "351",
						"endLine": "351",
						"relevantVariables": [
							"cbDebugRun",
							"cbDebugRunInternal"
						]
					},
					"inputDataExample": "{\n  \"command\": \"run\",\n  \"arguments\": []\n}",
					"outputDataExample": "{\n  \"command\": \"run\",\n  \"arguments\": []\n}"
				},
				{
					"simStepId": "32dbae95-4c6e-4f3e-b05d-b15ee68bbccf",
					"diagramNodeId": "06e155f5-bf39-4d42-a95e-686d58d9d34f",
					"simStepLabel": "Flow: Run - Unlock the Debug Loop",
					"simStepDescription": "The `cbDebugRunInternal` function checks if the debugger is already running using `dbgisrunning()`. Since it's paused, the check returns false. It then updates the GUI state to 'running' and, most importantly, calls `unlock(WAITID_RUN)`. This releases the lock that was holding the main debug loop.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-debug-control.cpp",
						"startLine": "56",
						"endLine": "62",
						"relevantVariables": [
							"cbDebugRunInternal",
							"dbgisrunning",
							"GuiSetDebugStateAsync",
							"unlock",
							"WAITID_RUN",
							"plugincbcall",
							"CB_RESUMEDEBUG"
						]
					},
					"inputDataExample": "{\n  \"is_running\": false\n}",
					"outputDataExample": "{\n  \"gui_state\": \"running\",\n  \"wait_id_unlocked\": \"WAITID_RUN\"\n}"
				},
				{
					"simStepId": "6488fa06-f813-44b4-94a2-a10d77c1b961",
					"diagramNodeId": "5aa64a5b-4197-4812-a621-d2e111ecd03a",
					"simStepLabel": "Flow: Run - Debug Loop Resumes",
					"simStepDescription": "The call to `unlock(WAITID_RUN)` signals the waiting `DebugLoop`, which was blocked on `wait(WAITID_RUN)`. The loop now continues, allowing the debuggee to execute freely.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "1839",
						"endLine": "1839",
						"relevantVariables": [
							"wait",
							"WAITID_RUN"
						]
					},
					"inputDataExample": "{\n  \"wait_id_unlocked\": \"WAITID_RUN\"\n}",
					"outputDataExample": "{\n  \"wait_id_unlocked\": \"WAITID_RUN\"\n}"
				},
				{
					"simStepId": "bac07393-283d-45cd-ab19-3d9b8ee38781",
					"diagramNodeId": "5ade3687-a5b4-4ffc-ab93-383749e6bd13",
					"simStepLabel": "Flow: Run - Debuggee is Running",
					"simStepDescription": "The `DebugLoop` continues to process OS debug events as they occur (exceptions, breakpoints, etc.). From the user's perspective, the program is now running until it hits a breakpoint or is paused again.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.h",
						"startLine": "76",
						"endLine": "76",
						"relevantVariables": [
							"dbgisrunning"
						]
					},
					"inputDataExample": "null",
					"outputDataExample": "{\n  \"state\": \"running\"\n}"
				},
				{
					"simStepId": "c727ab5d-6944-4924-99bb-507001b74ea0",
					"diagramNodeId": "36c05c47-2b74-4fa9-80c1-8677015c4d34",
					"simStepLabel": "Flow: Pause - User Issues 'pause' Command",
					"simStepDescription": "While the debuggee is running, the user issues the 'pause' command. This is registered to the `cbDebugPause` callback.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/x64dbg.cpp",
						"startLine": "151",
						"endLine": "151",
						"relevantVariables": [
							"dbgcmdnew",
							"cbDebugPause"
						]
					},
					"inputDataExample": "{\n  \"command\": \"pause\"\n}",
					"outputDataExample": "{\n  \"command\": \"pause\",\n  \"arguments\": []\n}"
				},
				{
					"simStepId": "b097570e-3245-4ef2-b848-a495ef294cb4",
					"diagramNodeId": "68651db8-7bd2-493d-ad61-87cbae7eb1a2",
					"simStepLabel": "Flow: Pause - Dispatch to Command Handler",
					"simStepDescription": "The command is dispatched to the `cbDebugPause` function.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-debug-control.cpp",
						"startLine": "372",
						"endLine": "372",
						"relevantVariables": [
							"cbDebugPause"
						]
					},
					"inputDataExample": "{\n  \"command\": \"pause\",\n  \"arguments\": []\n}",
					"outputDataExample": "{\n  \"command\": \"pause\",\n  \"arguments\": []\n}"
				},
				{
					"simStepId": "ce8992b5-e886-4932-81e2-cc0e2e61a84f",
					"diagramNodeId": "a81dd32a-c883-4f56-a91e-484584219931",
					"simStepLabel": "Flow: Pause - Set Temporary Breakpoint",
					"simStepDescription": "The `cbDebugPause` function confirms the debuggee is running via `dbgisrunning()`. It then suspends the active thread, sets a temporary single-shot INT3 breakpoint at the current instruction pointer (CIP), and immediately resumes the thread. This forces the debuggee to break at its current location.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-debug-control.cpp",
						"startLine": "394",
						"endLine": "429",
						"relevantVariables": [
							"dbgisrunning",
							"SuspendThread",
							"SetBPX",
							"cbPauseBreakpoint",
							"ResumeThread"
						]
					},
					"inputDataExample": "{\n  \"is_running\": true\n}",
					"outputDataExample": "{\n  \"breakpoint_address\": \"0x00401050\",\n  \"callback\": \"cbPauseBreakpoint\"\n}"
				},
				{
					"simStepId": "fe7bb364-e5e3-4e61-af39-848f7540ff76",
					"diagramNodeId": "5f2e69fb-3dc5-40f7-9ac4-f2921f05e053",
					"simStepLabel": "Flow: Pause - Temporary Breakpoint Hit",
					"simStepDescription": "The resumed thread immediately executes the instruction where the temporary breakpoint was placed, triggering a breakpoint exception. The debug loop catches this and dispatches it to the specified callback, `cbPauseBreakpoint`.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "788",
						"endLine": "788",
						"relevantVariables": [
							"cbPauseBreakpoint"
						]
					},
					"inputDataExample": "{\n  \"DebugEvent\": {\n    \"dwDebugEventCode\": \"EXCEPTION_DEBUG_EVENT\",\n    \"ExceptionRecord\": {\n      \"ExceptionCode\": \"EXCEPTION_BREAKPOINT\",\n      \"ExceptionAddress\": \"0x00401050\"\n    }\n  }\n}",
					"outputDataExample": "{\n  \"DebugEvent\": {\n    \"dwDebugEventCode\": \"EXCEPTION_DEBUG_EVENT\",\n    \"ExceptionRecord\": {\n      \"ExceptionCode\": \"EXCEPTION_BREAKPOINT\",\n      \"ExceptionAddress\": \"0x00401050\"\n    }\n  }\n}"
				},
				{
					"simStepId": "ba589bea-0433-4b28-9ca1-044ebccf15bd",
					"diagramNodeId": "4b9baf12-6ea0-44ba-9027-f03cc9e393b7",
					"simStepLabel": "Flow: Pause - Lock Debug Loop",
					"simStepDescription": "The `cbPauseBreakpoint` function is executed. It removes the temporary breakpoint it just hit, updates the GUI to the 'paused' state, and crucially calls `lock(WAITID_RUN)`. This blocks the `DebugLoop` from continuing, pausing execution.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "788",
						"endLine": "806",
						"relevantVariables": [
							"cbPauseBreakpoint",
							"DeleteBPX",
							"DebugUpdateGuiSetStateAsync",
							"lock",
							"WAITID_RUN",
							"wait"
						]
					},
					"inputDataExample": "{\n  \"breakpoint_address\": \"0x00401050\"\n}",
					"outputDataExample": "{\n  \"state\": \"paused\",\n  \"wait_id\": \"WAITID_RUN\"\n}"
				},
				{
					"simStepId": "a56744f7-c673-4615-8806-fc4814fd3c1e",
					"diagramNodeId": "a1cb526f-042b-459c-9882-d8457d9686b9",
					"simStepLabel": "Flow: Step - User Issues 'step' Command",
					"simStepDescription": "When paused, the user issues a stepping command, such as 'stepinto' (F7) or 'stepover' (F8). These commands are registered to `cbDebugStepInto` and `cbDebugStepOver` respectively.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/x64dbg.cpp",
						"startLine": "153",
						"endLine": "156",
						"relevantVariables": [
							"dbgcmdnew",
							"cbDebugStepInto",
							"cbDebugStepOver"
						]
					},
					"inputDataExample": "{\n  \"command\": \"stepinto\"\n}",
					"outputDataExample": "{\n  \"command\": \"stepinto\",\n  \"arguments\": []\n}"
				},
				{
					"simStepId": "b166bc3b-e450-4a88-879b-6d28c2822b5e",
					"diagramNodeId": "7fad645d-ced6-457f-833c-30bf25250dd7",
					"simStepLabel": "Flow: Step - Dispatch to Command Handler",
					"simStepDescription": "The command is dispatched to the appropriate handler, for example `cbDebugStepInto`.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-debug-control.cpp",
						"startLine": "448",
						"endLine": "448",
						"relevantVariables": [
							"cbDebugStepInto"
						]
					},
					"inputDataExample": "{\n  \"command\": \"stepinto\",\n  \"arguments\": []\n}",
					"outputDataExample": "{\n  \"command\": \"stepinto\",\n  \"arguments\": []\n}"
				},
				{
					"simStepId": "2b1756b2-6bc7-4e7e-bb99-9c8d07fa70e2",
					"diagramNodeId": "e8a08968-e1d9-464c-b23c-c60818c9f680",
					"simStepLabel": "Flow: Step - Configure Step and Unlock Debug Loop",
					"simStepDescription": "The step handler (`cbDebugStepInto` or `cbDebugStepOver`) configures the debug engine for the desired step type by calling `StepIntoWow64` or `StepOverWrapper`, providing `cbStep` as the callback. It then calls `cbDebugRunInternal` to `unlock(WAITID_RUN)`, allowing the debug loop to proceed for a single step.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-debug-control.cpp",
						"startLine": "457",
						"endLine": "459",
						"relevantVariables": [
							"cbDebugStepInto",
							"StepIntoWow64",
							"cbStep",
							"cbDebugRunInternal"
						]
					},
					"inputDataExample": "null",
					"outputDataExample": "{\n  \"step_callback\": \"cbStep\",\n  \"wait_id_unlocked\": \"WAITID_RUN\"\n}"
				},
				{
					"simStepId": "465c925c-bfc6-4ac0-b78e-277ca135ce92",
					"diagramNodeId": "f4a6cfb8-0f9b-4071-8670-62f0dfa02c07",
					"simStepLabel": "Flow: Step - Single Step Event",
					"simStepDescription": "The debuggee executes one instruction. The CPU's trap flag causes the OS to generate a `SINGLE_STEP` debug event, which is caught by the `DebugLoop` and dispatched to the registered callback.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "1302",
						"endLine": "1302",
						"relevantVariables": [
							"cbStep"
						]
					},
					"inputDataExample": "{\n  \"DebugEvent\": {\n    \"dwDebugEventCode\": \"EXCEPTION_DEBUG_EVENT\",\n    \"ExceptionRecord\": {\n      \"ExceptionCode\": \"EXCEPTION_SINGLE_STEP\"\n    }\n  }\n}",
					"outputDataExample": "{\n  \"DebugEvent\": {\n    \"dwDebugEventCode\": \"EXCEPTION_DEBUG_EVENT\",\n    \"ExceptionRecord\": {\n      \"ExceptionCode\": \"EXCEPTION_SINGLE_STEP\"\n    }\n  }\n}"
				},
				{
					"simStepId": "222eaab1-3388-4c1c-8ca6-43170482a57d",
					"diagramNodeId": "7fb45274-be79-45b5-a578-f7ad58f69682",
					"simStepLabel": "Flow: Step - Handle Step Completion and Pause",
					"simStepDescription": "The `cbStep` callback is executed. It updates the GUI to the 'paused' state, re-locks the debug loop by calling `lock(WAITID_RUN)`, and then waits for the next user command. The debugger is now paused at the next instruction.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "1302",
						"endLine": "1329",
						"relevantVariables": [
							"cbStep",
							"DebugUpdateGuiSetStateAsync",
							"lock",
							"WAITID_RUN",
							"wait"
						]
					},
					"inputDataExample": "{\n  \"new_cip\": \"0x00401054\"\n}",
					"outputDataExample": "{\n  \"state\": \"paused\",\n  \"wait_id\": \"WAITID_RUN\"\n}"
				}
			],
			"description": "<ul><li>- Users initiate a debugging session by either starting a new executable or attaching to a running process</li><li>- Core execution commands include running (F9), pausing, stepping into (F7), and stepping over (F8) instructions</li><li>- The debugger core manages the debuggee's state (running, paused) and communicates changes to the GUI via a bridge mechanism</li><li>- The main debug loop, handled in <code>debugger</li><li>cpp</code>, waits for debug events from the OS and processes them accordingly</li></ul>",
