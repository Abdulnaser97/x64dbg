		"7135837f-6e40-4848-aaaf-fac4821004df": {
			"path": "7135837f-6e40-4848-aaaf-fac4821004df",
			"fileName": "7135837f-6e40-4848-aaaf-fac4821004df",
			"cellName": "Core Disassembly: Zydis Library Decoding and Formatting - zydis_wrapper.cpp:L91-118",
			"cellId": "7135837f-6e40-4848-aaaf-fac4821004df",
			"visible": true,
			"parentCellId": "a0253e35-4c83-4186-b24e-1881f2cd4a4a"
		},
		"src/zydis_wrapper/zydis_wrapper.cpp-simstep-58f5b061-cc33-4e36-a39f-57bdae025b12": {
			"path": "src/zydis_wrapper/zydis_wrapper.cpp-simstep-58f5b061-cc33-4e36-a39f-57bdae025b12",
			"fileName": "zydis_wrapper.cpp",
			"wiki": "The `Zydis` wrapper calls `ZydisDecoderDecodeFull` to parse the machine code into a structured `ZydisDecodedInstruction`. It then uses `ZydisFormatterFormatInstruction` to get a human-readable text representation. Finally, it post-processes operands, for instance, calculating absolute addresses for relative operands using `ZydisCalcAbsoluteAddress`.",
			"cellName": "Core Disassembly: Zydis Library Decoding and Formatting - zydis_wrapper.cpp:L91-118",
			"cellId": "7135837f-6e40-4848-aaaf-fac4821004df",
			"visible": true,
			"startLine": 91,
			"endLine": 118,
			"parentCellId": "a0253e35-4c83-4186-b24e-1881f2cd4a4a",
			"parentPath": "src/zydis_wrapper/zydis_wrapper.cpp",
			"simSteps": [
				{
					"simulationKey": "How code analysis and navigation works",
					"simStepId": "58f5b061-cc33-4e36-a39f-57bdae025b12"
				}
			]
		},
		"c5eba0d7-5b22-4d77-8f0a-dc79aef3c358": {
			"path": "c5eba0d7-5b22-4d77-8f0a-dc79aef3c358",
			"fileName": "c5eba0d7-5b22-4d77-8f0a-dc79aef3c358",
			"cellName": "Token Generation: ZydisTokenizer Creates Tokens - ZydisTokenizer.cpp:L139-171",
			"cellId": "c5eba0d7-5b22-4d77-8f0a-dc79aef3c358",
			"visible": true,
			"parentCellId": "12d1d631-dfd0-4fcb-a4f0-cdd0ff5a4c2a"
		},
		"src/gui/Src/Disassembler/ZydisTokenizer.cpp-simstep-fc56aef9-cc34-4bf9-8c78-bef6de54d8a7": {
			"path": "src/gui/Src/Disassembler/ZydisTokenizer.cpp-simstep-fc56aef9-cc34-4bf9-8c78-bef6de54d8a7",
			"fileName": "ZydisTokenizer.cpp",
			"wiki": "The `ZydisTokenizer` processes the results from the `Zydis` wrapper. It breaks down the instruction into logical parts (prefixes, mnemonic, operands) and creates a series of `SingleToken` objects, assigning a type to each for syntax highlighting.",
			"cellName": "Token Generation: ZydisTokenizer Creates Tokens - ZydisTokenizer.cpp:L139-171",
			"cellId": "c5eba0d7-5b22-4d77-8f0a-dc79aef3c358",
			"visible": true,
			"startLine": 139,
			"endLine": 171,
			"parentCellId": "12d1d631-dfd0-4fcb-a4f0-cdd0ff5a4c2a",
			"parentPath": "src/gui/Src/Disassembler/ZydisTokenizer.cpp",
			"simSteps": [
				{
					"simulationKey": "How code analysis and navigation works",
					"simStepId": "fc56aef9-cc34-4bf9-8c78-bef6de54d8a7"
				}
			]
		},
		"44c6ae39-15af-411d-8c5c-e81ee2aab945": {
			"path": "44c6ae39-15af-411d-8c5c-e81ee2aab945",
			"fileName": "44c6ae39-15af-411d-8c5c-e81ee2aab945",
			"cellName": "Final Step: Rendering Instruction Text - DisassemblerGraphView.cpp:L2061-2116",
			"cellId": "44c6ae39-15af-411d-8c5c-e81ee2aab945",
			"visible": true,
			"parentCellId": "a2515494-8e4d-4df9-9ea6-5534c327fe4c"
		},
		"src/gui/Src/Gui/DisassemblerGraphView.cpp-simstep-87c61a43-5851-46ca-9d2d-2daf42c7b7ad": {
			"path": "src/gui/Src/Gui/DisassemblerGraphView.cpp-simstep-87c61a43-5851-46ca-9d2d-2daf42c7b7ad",
			"fileName": "DisassemblerGraphView.cpp",
			"wiki": "The `DisassemblerGraphView` receives the `Instruction_t` object. It then converts the list of tokens into a `RichTextPainter::List`, which contains all necessary information (text, color, background) to render the syntax-highlighted instruction inside a graph node during the `paintEvent`.",
			"cellName": "Final Step: Rendering Instruction Text - DisassemblerGraphView.cpp:L2061-2116",
			"cellId": "44c6ae39-15af-411d-8c5c-e81ee2aab945",
			"visible": true,
			"startLine": 2061,
			"endLine": 2116,
			"parentCellId": "a2515494-8e4d-4df9-9ea6-5534c327fe4c",
			"parentPath": "src/gui/Src/Gui/DisassemblerGraphView.cpp",
			"simSteps": [
				{
					"simulationKey": "How code analysis and navigation works",
					"simStepId": "87c61a43-5851-46ca-9d2d-2daf42c7b7ad"
				}
			]
		},
		"d6b1f638-e50d-402f-b3b3-ba23efee43d6": {
			"path": "d6b1f638-e50d-402f-b3b3-ba23efee43d6",
			"fileName": "d6b1f638-e50d-402f-b3b3-ba23efee43d6",
			"cellName": "Graph Layout Calculation - DisassemblerGraphView.cpp:L1540-1895",
			"cellId": "d6b1f638-e50d-402f-b3b3-ba23efee43d6",
			"visible": true,
			"parentCellId": "a2515494-8e4d-4df9-9ea6-5534c327fe4c"
		},
		"src/gui/Src/Gui/DisassemblerGraphView.cpp-simstep-3a5b1fc1-d9ee-4086-b230-8ec4479e12af": {
			"path": "src/gui/Src/Gui/DisassemblerGraphView.cpp-simstep-3a5b1fc1-d9ee-4086-b230-8ec4479e12af",
			"fileName": "DisassemblerGraphView.cpp",
			"wiki": "The `renderFunction` orchestrates the entire graph layout process. It first computes the relative positions of nodes (`computeGraphLayout`), then determines the paths for the edges connecting them (`routeEdge`), calculates the final pixel coordinates for all elements, and schedules a repaint of the viewport.",
			"cellName": "Graph Layout Calculation - DisassemblerGraphView.cpp:L1540-1895",
			"cellId": "d6b1f638-e50d-402f-b3b3-ba23efee43d6",
			"visible": true,
			"startLine": 1540,
			"endLine": 1895,
			"parentCellId": "a2515494-8e4d-4df9-9ea6-5534c327fe4c",
			"parentPath": "src/gui/Src/Gui/DisassemblerGraphView.cpp",
			"simSteps": [
				{
					"simulationKey": "How code analysis and navigation works",
					"simStepId": "3a5b1fc1-d9ee-4086-b230-8ec4479e12af"
				}
			]
		},
		"e30271a9-cf3c-4685-ba83-b126bb4dfeec": {
			"path": "e30271a9-cf3c-4685-ba83-b126bb4dfeec",
			"fileName": "e30271a9-cf3c-4685-ba83-b126bb4dfeec",
			"cellName": "Graph Rendering - DisassemblerGraphView.cpp:L811-857",
			"cellId": "e30271a9-cf3c-4685-ba83-b126bb4dfeec",
			"visible": true,
			"parentCellId": "a2515494-8e4d-4df9-9ea6-5534c327fe4c"
		},
		"src/gui/Src/Gui/DisassemblerGraphView.cpp-simstep-a1f04f9a-0450-4645-a876-a2fdac12c2b7": {
			"path": "src/gui/Src/Gui/DisassemblerGraphView.cpp-simstep-a1f04f9a-0450-4645-a876-a2fdac12c2b7",
			"fileName": "DisassemblerGraphView.cpp",
			"wiki": "The `paintEvent` handler is executed by the GUI framework. It uses a `QPainter` object to draw the graph's nodes, edges, and the disassembled instruction text (which was prepared in the previous flow) onto the viewport widget, making the control flow graph visible to the user.",
			"cellName": "Graph Rendering - DisassemblerGraphView.cpp:L811-857",
			"cellId": "e30271a9-cf3c-4685-ba83-b126bb4dfeec",
			"visible": true,
			"startLine": 811,
			"endLine": 857,
			"parentCellId": "a2515494-8e4d-4df9-9ea6-5534c327fe4c",
			"parentPath": "src/gui/Src/Gui/DisassemblerGraphView.cpp",
			"simSteps": [
				{
					"simulationKey": "How code analysis and navigation works",
					"simStepId": "a1f04f9a-0450-4645-a876-a2fdac12c2b7"
				}
			]
		},
		"6b16f6f3-79aa-440a-a603-10e6c8923238": {
			"path": "6b16f6f3-79aa-440a-a603-10e6c8923238",
			"fileName": "6b16f6f3-79aa-440a-a603-10e6c8923238",
			"cellName": "Navigation Command Execution - DisassemblerGraphView.cpp:L1212",
			"cellId": "6b16f6f3-79aa-440a-a603-10e6c8923238",
			"visible": true,
			"parentCellId": "a2515494-8e4d-4df9-9ea6-5534c327fe4c"
		},
		"src/gui/Src/Gui/DisassemblerGraphView.cpp-simstep-8141a50a-9f15-4591-80ba-48f75191243b": {
			"path": "src/gui/Src/Gui/DisassemblerGraphView.cpp-simstep-8141a50a-9f15-4591-80ba-48f75191243b",
			"fileName": "DisassemblerGraphView.cpp",
			"wiki": "The double-click event handler constructs and executes a `graph dis.branchdest(...)` command. This command instructs the debugger to resolve the branch destination of the specified instruction and then redraw the graph at that new address.",
			"cellName": "Navigation Command Execution - DisassemblerGraphView.cpp:L1212",
			"cellId": "6b16f6f3-79aa-440a-a603-10e6c8923238",
			"visible": true,
			"startLine": 1212,
			"endLine": 1212,
			"parentCellId": "a2515494-8e4d-4df9-9ea6-5534c327fe4c",
			"parentPath": "src/gui/Src/Gui/DisassemblerGraphView.cpp",
			"simSteps": [
				{
					"simulationKey": "How code analysis and navigation works",
					"simStepId": "8141a50a-9f15-4591-80ba-48f75191243b"
				}
			]
		},
		"b23655ae-ab6d-459e-b3ce-5a26a4c4ec16": {
			"path": "b23655ae-ab6d-459e-b3ce-5a26a4c4ec16",
			"fileName": "b23655ae-ab6d-459e-b3ce-5a26a4c4ec16",
			"cellName": "Backend: Branch Destination Resolution - _exports.cpp:L801-893",
			"cellId": "b23655ae-ab6d-459e-b3ce-5a26a4c4ec16",
			"visible": true,
			"parentCellId": "29a4057e-b0a1-47ae-8010-f61559b680a1"
		},
		"src/dbg/_exports.cpp-simstep-1702281e-39ff-4eb8-a093-6aa0503b3e12": {
			"path": "src/dbg/_exports.cpp-simstep-1702281e-39ff-4eb8-a093-6aa0503b3e12",
			"fileName": "_exports.cpp",
			"wiki": "The `_dbg_getbranchdestination` function reads the instruction bytes, disassembles them using Zydis, and if it's a branch, resolves the destination. It can handle direct jumps (immediates), indirect jumps via registers, and memory-based jumps, using the current register context if necessary.",
			"cellName": "Backend: Branch Destination Resolution - _exports.cpp:L801-893",
			"cellId": "b23655ae-ab6d-459e-b3ce-5a26a4c4ec16",
			"visible": true,
			"startLine": 801,
			"endLine": 893,
			"parentCellId": "29a4057e-b0a1-47ae-8010-f61559b680a1",
			"parentPath": "src/dbg/_exports.cpp",
			"simSteps": [
				{
					"simulationKey": "How code analysis and navigation works",
					"simStepId": "1702281e-39ff-4eb8-a093-6aa0503b3e12"
				}
			]
		},
		"a5461ffd-c5c7-47f3-bf4a-35c97e853e71": {
			"path": "a5461ffd-c5c7-47f3-bf4a-35c97e853e71",
			"fileName": "a5461ffd-c5c7-47f3-bf4a-35c97e853e71",
			"cellName": "User Action: Request Cross-References - DisassemblerGraphView.cpp:L2613-2632",
			"cellId": "a5461ffd-c5c7-47f3-bf4a-35c97e853e71",
			"visible": true,
			"parentCellId": "a2515494-8e4d-4df9-9ea6-5534c327fe4c"
		},
		"src/gui/Src/Gui/DisassemblerGraphView.cpp-simstep-fc71c6c5-e506-4996-8f7d-b064dbdca723": {
			"path": "src/gui/Src/Gui/DisassemblerGraphView.cpp-simstep-fc71c6c5-e506-4996-8f7d-b064dbdca723",
			"fileName": "DisassemblerGraphView.cpp",
			"wiki": "The user right-clicks an instruction in the disassembly or graph view and selects the 'Xrefs...' option from the context menu to find all references to the selected address.",
			"cellName": "User Action: Request Cross-References - DisassemblerGraphView.cpp:L2613-2632",
