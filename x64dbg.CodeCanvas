		"src/gui/Src/Gui/MemoryMapView.cpp-simstep-f2f06ecf-fbe8-48ac-87a8-8be166310f3f": {
			"path": "src/gui/Src/Gui/MemoryMapView.cpp-simstep-f2f06ecf-fbe8-48ac-87a8-8be166310f3f",
			"fileName": "MemoryMapView.cpp",
			"wiki": "The `dumpMemorySlot` opens a file dialog. After the user chooses a file name, it executes the 'savedata' command via `DbgCmdExec`, passing the file name, start address, and size of the selected region.",
			"cellName": "GUI: Execute 'savedata' Command - MemoryMapView.cpp:L725-756",
			"cellId": "8f81fd69-f4a0-4abb-b12b-e75b1bd0da92",
