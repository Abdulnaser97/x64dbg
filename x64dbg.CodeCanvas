		},
		"ae655592-a257-40e9-abdc-89a6516a6eb5": {
			"path": "ae655592-a257-40e9-abdc-89a6516a6eb5",
			"fileName": "ae655592-a257-40e9-abdc-89a6516a6eb5",
			"cellName": "Validate PDB and Start Async Threads - symbolsourcedia.cpp:L45-70",
			"cellId": "ae655592-a257-40e9-abdc-89a6516a6eb5",
			"visible": true,
			"parentCellId": "9c77a76e-f846-4023-889a-21876feba5f4"
		},
		"src/dbg/symbolsourcedia.cpp-simstep-c08a3c69-0cb8-4a7d-8177-565d7359d4bd": {
			"path": "src/dbg/symbolsourcedia.cpp-simstep-c08a3c69-0cb8-4a7d-8177-565d7359d4bd",
			"fileName": "symbolsourcedia.cpp",
			"wiki": "`SymbolSourceDIA::loadPDB` uses a `PDBDiaFile` object to open the PDB and validate its signature against the module's debug information. If valid, it creates and starts two background threads: one for symbols (`loadSymbolsAsync`) and one for source lines (`loadSourceLinesAsync`).",
			"cellName": "Validate PDB and Start Async Threads - symbolsourcedia.cpp:L45-70",
			"cellId": "ae655592-a257-40e9-abdc-89a6516a6eb5",
			"visible": true,
			"startLine": 45,
			"endLine": 70,
			"parentCellId": "9c77a76e-f846-4023-889a-21876feba5f4",
			"parentPath": "src/dbg/symbolsourcedia.cpp",
			"simSteps": [
				{
					"simulationKey": "How symbol and source-level debugging works",
					"simStepId": "c08a3c69-0cb8-4a7d-8177-565d7359d4bd"
				}
			]
		},
		"ede633c5-30b4-4117-b09f-c63ef9c89843": {
			"path": "ede633c5-30b4-4117-b09f-c63ef9c89843",
			"fileName": "ede633c5-30b4-4117-b09f-c63ef9c89843",
			"cellName": "Enumerate Symbols with DIA SDK - pdbdiafile.cpp:L570-673",
